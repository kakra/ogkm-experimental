From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Englund <tomenglund26@gmail.com>
Date: Sun, 1 Nov 2026 02:42:55 +0100
Subject: [PATCH] nvidia: send ACPI power source and NVPCF events to every GPU

rm_power_source_change_event() and rm_acpi_nvpcf_notify() only handled
gpumgrGetGpu(0), on the assumption that a notebook has one GPU. With an eGPU, or
with two internal GPUs, the others never heard about it and stayed on the source
they read at init. If instance 0 isn't initialized, nobody hears about it.

Handle every attached GPU. The power source only goes to GPUs with the mobile
config, the ones adapter init already tells. That is a change for a non-mobile
GPU at instance 0, which used to get these events but not the initial state. A
failure on one GPU doesn't stop the others.

Shutting down one adapter also removed the system-wide _PSR and NVPCF notifiers
for all of them, until some adapter was initialized again. Only remove them when
the last GPU is detached.

Booted on a laptop with one GPU and one _PSR, where unplugging and replugging AC
still moves the power limit. The case this fixes hasn't been run.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/nvidia/arch/nvalloc/unix/src/osapi.c  | 62 ++++++++++++++++-------
 src/nvidia/arch/nvalloc/unix/src/osinit.c | 14 ++++-
 2 files changed, 57 insertions(+), 19 deletions(-)

diff --git a/src/nvidia/arch/nvalloc/unix/src/osapi.c b/src/nvidia/arch/nvalloc/unix/src/osapi.c
index 96c4eec8..ce488a73 100644
--- a/src/nvidia/arch/nvalloc/unix/src/osapi.c
+++ b/src/nvidia/arch/nvalloc/unix/src/osapi.c
@@ -4833,8 +4833,8 @@ NV_STATUS NV_API_CALL rm_perform_version_check(
 
 //
 // Handles the Power Source Change event(AC/DC) for Notebooks.
-// Notebooks from Maxwell have only one Gpu, so this functions grabs first Gpu
-// from GpuMgr and call subdevice RmControl.
+// The power source is system-wide, so every notebook GPU is told, the same ones
+// that are told at adapter init and system resume.
 //
 void NV_API_CALL rm_power_source_change_event(
     nvidia_stack_t *sp,
@@ -4852,29 +4852,40 @@ void NV_API_CALL rm_power_source_change_event(
     // LOCK: acquire API lock
     if ((rmStatus = rmapiLockAcquire(API_LOCK_FLAGS_NONE, RM_LOCK_MODULES_EVENT)) == NV_OK)
     {
-        OBJGPU *pGpu = gpumgrGetGpu(0);
-        if (pGpu != NULL)
+        OBJGPU *pGpu;
+        NvU32 gpuMask = 0;
+        NvU32 gpuInstance = 0;
+        NvU32 ac_plugged = 0;
+
+        //
+        // ACPI notify handlers can run concurrently, so event_val may
+        // already be out of date by the time the lock is acquired. Read
+        // the state again so that the last handler applies the latest one.
+        //
+        if (nv_acpi_get_powersource(&ac_plugged) == NV_OK)
+        {
+            event_val = !ac_plugged;
+        }
+
+        (void)gpumgrGetGpuAttachInfo(NULL, &gpuMask);
+
+        while ((pGpu = gpumgrGetNextGpu(gpuMask, &gpuInstance)) != NULL)
         {
             nv_priv_t *nvp;
-            NvU32 ac_plugged = 0;
 
             nv = NV_GET_NV_STATE(pGpu);
             nvp = NV_GET_NV_PRIV(nv);
+            rmStatus = NV_OK;
 
-            //
-            // ACPI notify handlers can run concurrently, so event_val may
-            // already be out of date by the time the lock is acquired. Read
-            // the state again so that the last handler applies the latest one.
-            //
-            if (nv_acpi_get_powersource(&ac_plugged) == NV_OK)
+            if ((nvp == NULL) || !nvp->b_mobile_config_enabled)
             {
-                event_val = !ac_plugged;
+                continue;
             }
 
             // Some systems generate spurious power source changed ACPI events.
             // Before entering the PM runtime and waking the GPU, see if the power
             // state has actually changed. If not, return without waking the GPU.
-            if ((nvp != NULL) && nvp->pm_state.PowerSourceKnown &&
+            if (nvp->pm_state.PowerSourceKnown &&
                 (nvp->pm_state.PowerSourceEventVal == event_val))
             {
                 // Nothing to do
@@ -4893,12 +4904,18 @@ void NV_API_CALL rm_power_source_change_event(
                 }
                 os_unref_dynamic_power(nv, NV_DYNAMIC_PM_FINE);
             }
+
+            if (rmStatus != NV_OK)
+            {
+                NV_PRINTF(LEVEL_ERROR,
+                          "%s: Failed to handle Power Source change event on GPU %u, status=0x%x\n",
+                          __FUNCTION__, pGpu->gpuInstance, rmStatus);
+            }
         }
         // UNLOCK: release API lock
         rmapiLockRelease();
     }
-
-    if (rmStatus != NV_OK)
+    else
     {
         NV_PRINTF(LEVEL_ERROR,
                   "%s: Failed to handle Power Source change event, status=0x%x\n",
@@ -6477,15 +6494,24 @@ void NV_API_CALL rm_acpi_nvpcf_notify(
     if ((rmStatus = rmapiLockAcquire(API_LOCK_FLAGS_NONE,
                                      RM_LOCK_MODULES_EVENT)) == NV_OK)
     {
-        OBJGPU *pGpu = gpumgrGetGpu(0);
+        OBJGPU *pGpu;
+        NvU32 gpuMask = 0;
+        NvU32 gpuInstance = 0;
+
+        (void)gpumgrGetGpuAttachInfo(NULL, &gpuMask);
+
         //
         // The only work done here is forwarding the event to clients. If no
         // client listens for NVPCF events (e.g. nvidia-powerd is not
         // running), skip it instead of waking a runtime-suspended GPU.
         //
-        if ((pGpu != NULL) &&
-            _rmGpuHasSubDeviceEventListener(pGpu, NV2080_NOTIFIERS_NVPCF_EVENTS))
+        while ((pGpu = gpumgrGetNextGpu(gpuMask, &gpuInstance)) != NULL)
         {
+            if (!_rmGpuHasSubDeviceEventListener(pGpu, NV2080_NOTIFIERS_NVPCF_EVENTS))
+            {
+                continue;
+            }
+
             nv_state_t *nv = NV_GET_NV_STATE(pGpu);
             if ((rmStatus = os_ref_dynamic_power(nv, NV_DYNAMIC_PM_FINE)) ==
                                                                          NV_OK)
diff --git a/src/nvidia/arch/nvalloc/unix/src/osinit.c b/src/nvidia/arch/nvalloc/unix/src/osinit.c
index 1c8f2e45..588bfa42 100644
--- a/src/nvidia/arch/nvalloc/unix/src/osinit.c
+++ b/src/nvidia/arch/nvalloc/unix/src/osinit.c
@@ -2504,7 +2504,19 @@ void RmShutdownAdapter(
 
                 RmClearPrivateState(nv);
 
-                RmUnInitAcpiMethods(pSys);
+                //
+                // The ACPI notifiers are system-wide. Keep them while another
+                // GPU is attached, or it stops getting those events.
+                //
+                {
+                    NvU32 gpuCount = 0;
+
+                    (void)gpumgrGetGpuAttachInfo(&gpuCount, NULL);
+                    if (gpuCount == 0)
+                    {
+                        RmUnInitAcpiMethods(pSys);
+                    }
+                }
 
                 // UNLOCK: release GPUs lock
                 rmGpuLocksRelease(GPUS_LOCK_FLAGS_NONE, NULL);
