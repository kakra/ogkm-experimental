@@ -2009,7 +2009,7 @@ NV_STATUS NV_API_CALL nv_dma_import_from_fd
     nv_dma_device_t *dma_dev,
     NvS32 fd,
     NvBool is_ro_device_map,
-    NvU32 *size,
