@@ -1396,7 +1396,7 @@ struct NvKmsKapiFunctionsTable {
     struct NvKmsKapiMemory*
     (*getSystemMemoryHandleFromDmaBuf)(struct NvKmsKapiDevice *device,
                                        NvP64 dmaBuf,
-                                       NvU32 limit);
+                                       NvU64 limit);
 
     /*!
      * Import a semaphore surface allocated elsewhere to NVKMS and return a
diff --git a/src/nvidia-modeset/kapi/src/nvkms-kapi.c b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
