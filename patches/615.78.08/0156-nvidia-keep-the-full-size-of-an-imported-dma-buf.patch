From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Englund <tomenglund26@gmail.com>
Date: Sun, 1 Nov 2026 03:18:37 +0100
Subject: [PATCH] nvidia: keep the full size of an imported dma-buf

nv_dma_import_dma_buf() returned dma_buf->size through an NvU32, and the
RM memdesc helpers and the KAPI getSystemMemoryHandleFrom{DmaBuf,Sgt}()
limit argument were 32 bits too. A dma-buf of 4 GiB or more got a memdesc
for the size modulo 4 GiB: the GPU saw only part of the buffer, and
nv_load_dma_map_scatterlist() wrote DMA addresses for the whole sg table
past the end of the shorter IOVA array. Reached by dma-buf fd imports from
userspace and by every PRIME import into nvidia-drm.

Carry the size as 64 bits all the way.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernel-open/common/inc/nv.h                    |  4 ++--
 kernel-open/common/inc/nvkms-kapi.h            |  4 ++--
 kernel-open/nvidia/nv-dmabuf.c                 |  4 ++--
 src/nvidia-modeset/kapi/interface/nvkms-kapi.h |  4 ++--
 src/nvidia-modeset/kapi/src/nvkms-kapi.c       |  6 +++---
 src/nvidia/arch/nvalloc/unix/include/nv.h      |  4 ++--
 src/nvidia/arch/nvalloc/unix/src/osmemdesc.c   | 10 +++++-----
 7 files changed, 18 insertions(+), 18 deletions(-)

diff --git a/kernel-open/common/inc/nv.h b/kernel-open/common/inc/nv.h
index 566933c3..62bb0f30 100644
--- a/kernel-open/common/inc/nv.h
+++ b/kernel-open/common/inc/nv.h
@@ -1084,8 +1084,8 @@ struct drm_gem_object;
 
 NV_STATUS NV_API_CALL nv_dma_import_sgt  (nv_dma_device_t *, struct sg_table *, struct drm_gem_object *);
 void NV_API_CALL nv_dma_release_sgt(struct sg_table *, struct drm_gem_object *);
-NV_STATUS NV_API_CALL nv_dma_import_dma_buf      (nv_dma_device_t *, struct dma_buf *, NvBool, NvU32 *, struct sg_table **, nv_dma_buf_t **);
-NV_STATUS NV_API_CALL nv_dma_import_from_fd      (nv_dma_device_t *, NvS32, NvBool, NvU32 *, struct sg_table **, nv_dma_buf_t **);
+NV_STATUS NV_API_CALL nv_dma_import_dma_buf      (nv_dma_device_t *, struct dma_buf *, NvBool, NvU64 *, struct sg_table **, nv_dma_buf_t **);
+NV_STATUS NV_API_CALL nv_dma_import_from_fd      (nv_dma_device_t *, NvS32, NvBool, NvU64 *, struct sg_table **, nv_dma_buf_t **);
 void      NV_API_CALL nv_dma_release_dma_buf     (nv_dma_buf_t *);
 
 void      NV_API_CALL nv_schedule_uvm_isr        (nv_state_t *);
diff --git a/kernel-open/common/inc/nvkms-kapi.h b/kernel-open/common/inc/nvkms-kapi.h
