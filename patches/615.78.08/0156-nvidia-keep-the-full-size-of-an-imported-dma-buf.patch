                              NvP64 gem,
-                             NvU32 limit)
+                             NvU64 limit)
 {
     NVOS32_DESCRIPTOR_TYPE_OS_SGT_PTR_PARAMETERS params = {
         .sgt = sgt,
@@ -2127,7 +2127,7 @@ GetSystemMemoryHandleFromSgt(struct NvKmsKapiDevice *device,
