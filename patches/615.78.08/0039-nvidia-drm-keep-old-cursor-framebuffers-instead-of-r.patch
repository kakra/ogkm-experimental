From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Englund <tomenglund26@gmail.com>
Date: Sun, 25 Oct 2026 12:41:02 +0100
Subject: [PATCH] nvidia-drm: keep old cursor framebuffers instead of
 re-flipping all planes

A commit that only changes the cursor image generates no hardware flip
event (__will_generate_flip_event skips cursor planes), so its page-flip
event is sent right away. Userspace then frees the old cursor
framebuffer while the hardware may still read it until the next vblank.
NVIDIA works around this (bug 4966645) by adding every plane on the CRTC
to such commits, which turns each cursor image change (text/link hover,
resize edges, the animated busy cursor) into a full flip of all layers
that occupies the flip queue until the next vblank.

Fix the lifetime instead: nv_drm_atomic_commit takes a reference on any
framebuffer the commit removes from a cursor plane and drops it once the
new cursor is latched:
- if the commit enqueued a flip on the CRTC, the cursor change is part
  of that flip's display update -> released when that flip completes;
- otherwise (cursor-only commit) -> released 100 ms after all flips
  enqueued on the CRTC before the commit have completed.
Per-CRTC flips_enqueued/flips_completed counters (under flip_list_lock)
track this; __nv_drm_handle_flip_event kicks the release work. The puts
run from a work item because dropping the last reference unregisters
the surface from NVKMS, which sleeps.

With the old framebuffer kept alive the workaround is no longer needed;
drop it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernel-open/nvidia-drm/nvidia-drm-crtc.h    |  12 +
 kernel-open/nvidia-drm/nvidia-drm-drv.c     |   4 +
 kernel-open/nvidia-drm/nvidia-drm-modeset.c | 241 ++++++++++++++++++--
 kernel-open/nvidia-drm/nvidia-drm-modeset.h |   3 +
 kernel-open/nvidia-drm/nvidia-drm-priv.h    |   8 +
 5 files changed, 244 insertions(+), 24 deletions(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-crtc.h b/kernel-open/nvidia-drm/nvidia-drm-crtc.h
index e8f72d5d..b3e07e24 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-crtc.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-crtc.h
@@ -116,6 +116,16 @@ struct nv_drm_crtc {
      */
     spinlock_t flip_list_lock;
 
+    /**
+     * @flips_enqueued, @flips_completed:
+     *
+     * Number of flips added to and removed from @flip_list, i.e. submitted
+     * with a hardware flip event and completed. Protected by
+     * @flip_list_lock.
+     */
+    u64 flips_enqueued;
+    u64 flips_completed;
+
     /**
      * @modeset_permission_filep:
      *
@@ -414,6 +424,7 @@ static inline void nv_drm_crtc_enqueue_flip(struct nv_drm_crtc *nv_crtc,
 {
     spin_lock(&nv_crtc->flip_list_lock);
     list_add(&nv_flip->list_entry, &nv_crtc->flip_list);
+    nv_crtc->flips_enqueued++;
     spin_unlock(&nv_crtc->flip_list_lock);
 }
 
@@ -437,6 +448,7 @@ struct nv_drm_flip *nv_drm_crtc_dequeue_flip(struct nv_drm_crtc *nv_crtc)
         pending_events = --nv_flip->pending_events;
         if (!pending_events) {
             list_del(&nv_flip->list_entry);
+            nv_crtc->flips_completed++;
         }
     }
     spin_unlock(&nv_crtc->flip_list_lock);
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index c3a984b5..39ec5514 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -856,6 +856,8 @@ static int nv_drm_dev_load(struct drm_device *dev)
     mutex_init(&nv_dev->drm_lut_surface_pool_mutex);
     INIT_LIST_HEAD(&nv_dev->drm_lut_surface_pool);
 
+    nv_drm_held_fbs_init(nv_dev);
+
     /* Initialize drm_device::mode_config */
 
     nv_drm_init_mode_config(nv_dev, &resInfo);
@@ -965,6 +967,8 @@ static void nv_drm_dev_unload(struct drm_device *dev)
         nv_drm_workthread_shutdown(&nv_dev->vblank_worker);
     }
 
+    nv_drm_held_fbs_fini(nv_dev);
+
     /* Clean up mode configuration */
 
     drm_mode_config_cleanup(dev);
diff --git a/kernel-open/nvidia-drm/nvidia-drm-modeset.c b/kernel-open/nvidia-drm/nvidia-drm-modeset.c
index 06f39b32..ba0b169a 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-modeset.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-modeset.c
@@ -40,6 +40,7 @@
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_crtc.h>
 #include <drm/drm_file.h>
+#include <drm/drm_framebuffer.h>
 
 #if defined(NV_LINUX_NVHOST_H_PRESENT) && defined(CONFIG_TEGRA_GRHOST)
 #include <linux/nvhost.h>
@@ -643,32 +644,16 @@ int nv_drm_atomic_check(struct drm_device *dev,
     struct drm_crtc_state *crtc_state;
     int i;
 
-    struct drm_plane *plane;
-    struct drm_plane_state *plane_state;
-    int j;
-    bool cursor_surface_changed;
-    bool cursor_only_commit;
-
     bool infoframe_changed;
     for_each_new_crtc_in_state(state, crtc, crtc_state, i) {
 
         /*
-         * Committing cursor surface change without any other plane change can
-         * cause cursor surface in use by HW to be freed prematurely. Add all
-         * planes to the commit to avoid this. This is a workaround for bug 4966645.
+         * Cursor-only commits don't need the other planes added: committing a
+         * cursor surface change alone could let the old cursor surface be
+         * freed while the HW still reads it (bug 4966645), but
+         * nv_drm_atomic_commit() keeps the old cursor framebuffers until the
+         * new ones are latched (see nv_drm_hold_old_cursor_fbs()).
          */
-        cursor_surface_changed = false;
-        cursor_only_commit = true;
-        for_each_new_plane_in_state(crtc_state->state, plane, plane_state, j) {
-            if (plane->type == DRM_PLANE_TYPE_CURSOR) {
-                if (plane_state->fb != plane->state->fb) {
-                    cursor_surface_changed = true;
-                }
-            } else {
-                cursor_only_commit = false;
-                break;
-            }
-        }
 
         /*
          * Check if infoframe-related properties changed on any connector
@@ -722,9 +707,7 @@ int nv_drm_atomic_check(struct drm_device *dev,
          * the commit. Similarly, if infoframe properties changed, add all
          * planes to ensure the flip is serialized via flip_list.
          */
-        if (crtc_state->color_mgmt_changed ||
-            (cursor_surface_changed && cursor_only_commit) ||
-            infoframe_changed) {
+        if (crtc_state->color_mgmt_changed || infoframe_changed) {
             if ((ret = drm_atomic_add_affected_planes(state, crtc)) != 0) {
                 goto done;
             }
@@ -844,9 +827,209 @@ static void __nv_drm_handle_flip_event(struct nv_drm_crtc *nv_crtc)
 
     wake_up_all(&nv_dev->flip_event_wq);
 
+    /* Old cursor framebuffers may wait for this flip */
+    if (!list_empty(&nv_dev->held_fbs)) {
+        mod_delayed_work(nv_drm_percpu_wq, &nv_dev->held_fbs_work, 0);
+    }
+
     nv_drm_free(nv_flip);
 }
 
+/*
+ * A commit that replaces a cursor framebuffer may complete without a hardware
+ * flip event, so its event is sent right away and userspace may free the old
+ * framebuffer while the hardware still reads it until the next vblank (bug
+ * 4966645). Keep a reference on the old cursor framebuffers until the new
+ * ones are latched:
+ *
+ * - If the commit enqueued a flip on the CRTC, the cursor change is part of
+ *   that flip's display update; drop the reference once the flip completes.
+ * - Otherwise, once the flips enqueued before the commit have completed, wait
+ *   NV_DRM_OLD_CURSOR_FB_HOLD_MS for the cursor update to be latched.
+ *
+ * The references are dropped from a work item: dropping the last one
+ * unregisters the surface from NVKMS, which sleeps.
+ */
+#define NV_DRM_OLD_CURSOR_FB_HOLD_MS 100
+
+struct nv_drm_held_fb {
+    struct list_head list_entry;
+    struct drm_framebuffer *fb;
+    struct nv_drm_crtc *nv_crtc;
+    /* Release once nv_crtc->flips_completed reaches this */
+    u64 flip_target;
+    /* The commit enqueued the flip that flip_target counts */
+    bool carries_flip;
+    /* Release at release_time, set once flip_target was reached */
+    bool timer_started;
+    unsigned long release_time;
+};
+
+static void nv_drm_put_held_fbs(struct list_head *held_fbs)
+{
+    struct nv_drm_held_fb *held, *next;
+
+    list_for_each_entry_safe(held, next, held_fbs, list_entry) {
+        list_del(&held->list_entry);
+        drm_framebuffer_put(held->fb);
+        nv_drm_free(held);
+    }
+}
+
+static u64 nv_drm_crtc_read_flip_count(struct nv_drm_crtc *nv_crtc,
+                                       bool completed)
+{
+    u64 count;
+
+    spin_lock(&nv_crtc->flip_list_lock);
+    count = completed ? nv_crtc->flips_completed : nv_crtc->flips_enqueued;
+    spin_unlock(&nv_crtc->flip_list_lock);
+
+    return count;
+}
+
+/*
+ * Whether held can be released now. Otherwise, *delay is set to the time
+ * until it can be, or left alone if that waits for a flip to complete.
+ * Called with nv_drm_device::held_fbs_lock held.
+ */
+static bool nv_drm_held_fb_expired(struct nv_drm_held_fb *held,
+                                   unsigned long *delay)
+{
+    if (nv_drm_crtc_read_flip_count(held->nv_crtc, true) < held->flip_target) {
+        /* __nv_drm_handle_flip_event() kicks the work */
+        return false;
+    }
+
+    if (held->carries_flip) {
+        return true;
+    }
+
+    if (!held->timer_started) {
+        held->release_time =
+            jiffies + msecs_to_jiffies(NV_DRM_OLD_CURSOR_FB_HOLD_MS);
+        held->timer_started = true;
+    }
+
+    if (time_before(jiffies, held->release_time)) {
+        *delay = min(*delay, held->release_time - jiffies);
+        return false;
+    }
+
+    return true;
+}
+
+static void nv_drm_release_held_fbs_work(struct work_struct *work)
+{
+    struct nv_drm_device *nv_dev =
+        container_of(to_delayed_work(work), struct nv_drm_device,
+                     held_fbs_work);
+    struct nv_drm_held_fb *held, *next;
+    LIST_HEAD(expired);
+    unsigned long delay = ULONG_MAX;
+
+    spin_lock(&nv_dev->held_fbs_lock);
+    list_for_each_entry_safe(held, next, &nv_dev->held_fbs, list_entry) {
+        if (nv_drm_held_fb_expired(held, &delay)) {
+            list_move_tail(&held->list_entry, &expired);
+        }
+    }
+    spin_unlock(&nv_dev->held_fbs_lock);
+
+    nv_drm_put_held_fbs(&expired);
+
+    if (delay != ULONG_MAX) {
+        queue_delayed_work(nv_drm_percpu_wq, &nv_dev->held_fbs_work, delay);
+    }
+}
+
+void nv_drm_held_fbs_init(struct nv_drm_device *nv_dev)
+{
+    INIT_LIST_HEAD(&nv_dev->held_fbs);
+    spin_lock_init(&nv_dev->held_fbs_lock);
+    INIT_DELAYED_WORK(&nv_dev->held_fbs_work, nv_drm_release_held_fbs_work);
+}
+
+/* Called once no more commits or flip events can happen */
+void nv_drm_held_fbs_fini(struct nv_drm_device *nv_dev)
+{
+    LIST_HEAD(held_fbs);
+
+    cancel_delayed_work_sync(&nv_dev->held_fbs_work);
+
+    spin_lock(&nv_dev->held_fbs_lock);
+    list_splice_init(&nv_dev->held_fbs, &held_fbs);
+    spin_unlock(&nv_dev->held_fbs_lock);
+
+    nv_drm_put_held_fbs(&held_fbs);
+}
+
+/*
+ * Take a reference on the framebuffers that the commit removes from cursor
+ * planes. Called before drm_atomic_helper_swap_state(), so plane->state is
+ * the current state.
+ */
+static int nv_drm_hold_old_cursor_fbs(nv_drm_atomic_state_base_t *state,
+                                      struct list_head *held_fbs)
+{
+    struct drm_plane *plane;
+    struct drm_plane_state *new_plane_state;
+    int i;
+
+    for_each_new_plane_in_state(state, plane, new_plane_state, i) {
+        struct drm_framebuffer *old_fb = plane->state->fb;
+        struct nv_drm_held_fb *held;
+
+        if (plane->type != DRM_PLANE_TYPE_CURSOR ||
+            old_fb == NULL || old_fb == new_plane_state->fb ||
+            WARN_ON(plane->state->crtc == NULL)) {
+            continue;
+        }
+
+        held = nv_drm_calloc(1, sizeof(*held));
+        if (held == NULL) {
+            nv_drm_put_held_fbs(held_fbs);
+            return -ENOMEM;
+        }
+
+        drm_framebuffer_get(old_fb);
+        held->fb = old_fb;
+        held->nv_crtc = to_nv_crtc(plane->state->crtc);
+        /* The commit holds the CRTC's lock, no other commit enqueues flips */
+        held->flip_target = nv_drm_crtc_read_flip_count(held->nv_crtc, false);
+        list_add_tail(&held->list_entry, held_fbs);
+    }
+
+    return 0;
+}
+
+/* Called after the commit was handed to NVKMS */
+static void nv_drm_queue_held_fbs(struct nv_drm_device *nv_dev,
+                                  struct list_head *held_fbs)
+{
+    struct nv_drm_held_fb *held;
+
+    if (list_empty(held_fbs)) {
+        return;
+    }
+
+    list_for_each_entry(held, held_fbs, list_entry) {
+        const u64 enqueued =
+            nv_drm_crtc_read_flip_count(held->nv_crtc, false);
+
+        if (enqueued != held->flip_target) {
+            held->flip_target = enqueued;
+            held->carries_flip = true;
+        }
+    }
+
+    spin_lock(&nv_dev->held_fbs_lock);
+    list_splice_tail_init(held_fbs, &nv_dev->held_fbs);
+    spin_unlock(&nv_dev->held_fbs_lock);
+
+    mod_delayed_work(nv_drm_percpu_wq, &nv_dev->held_fbs_work, 0);
+}
+
 int nv_drm_atomic_commit(struct drm_device *dev,
                          nv_drm_atomic_state_base_t *state,
                          bool nonblock)
@@ -857,6 +1040,7 @@ int nv_drm_atomic_commit(struct drm_device *dev,
     struct drm_crtc *crtc = NULL;
     struct drm_crtc_state *crtc_state = NULL;
     struct nv_drm_device *nv_dev = to_nv_device(dev);
+    LIST_HEAD(held_fbs);
 
     /*
      * XXX: drm_mode_config_funcs::atomic_commit() mandates to return -EBUSY
@@ -926,8 +1110,14 @@ int nv_drm_atomic_commit(struct drm_device *dev,
      * expected.
      */
 
+    ret = nv_drm_hold_old_cursor_fbs(state, &held_fbs);
+    if (ret != 0) {
+        return ret;
+    }
+
     ret = drm_atomic_helper_swap_state(state, false /* stall */);
     if (WARN_ON(ret != 0)) {
+        nv_drm_put_held_fbs(&held_fbs);
         return ret;
     }
 
@@ -952,9 +1142,12 @@ int nv_drm_atomic_commit(struct drm_device *dev,
             "Failed to apply atomic modeset.  Error code: %d",
             ret);
 
+        nv_drm_queue_held_fbs(nv_dev, &held_fbs);
         goto done;
     }
 
+    nv_drm_queue_held_fbs(nv_dev, &held_fbs);
+
     for_each_old_crtc_in_state(state, crtc, crtc_state, i) {
         struct nv_drm_crtc *nv_crtc = to_nv_crtc(crtc);
         struct nv_drm_crtc_state *nv_new_crtc_state =
diff --git a/kernel-open/nvidia-drm/nvidia-drm-modeset.h b/kernel-open/nvidia-drm/nvidia-drm-modeset.h
index d9f393ac..0076395c 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-modeset.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-modeset.h
@@ -43,6 +43,9 @@ int nv_drm_atomic_check(struct drm_device *dev,
 int nv_drm_atomic_commit(struct drm_device *dev,
                          nv_drm_atomic_state_base_t *state, bool nonblock);
 
+void nv_drm_held_fbs_init(struct nv_drm_device *nv_dev);
+void nv_drm_held_fbs_fini(struct nv_drm_device *nv_dev);
+
 
 void nv_drm_handle_flip_occurred(struct nv_drm_device *nv_dev,
                                  NvU32 head, NvU32 plane);
diff --git a/kernel-open/nvidia-drm/nvidia-drm-priv.h b/kernel-open/nvidia-drm/nvidia-drm-priv.h
index d1f1b5fc..b268a476 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-priv.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-priv.h
@@ -199,6 +199,14 @@ struct nv_drm_device {
     NvU64 modifiers[6 /* block linear */ + 1 /* linear */ + 1 /* terminator */];
 
     struct delayed_work hotplug_event_work;
+
+    /*
+     * Old cursor framebuffers kept until the hardware stops reading them,
+     * see nv_drm_hold_old_cursor_fbs().
+     */
+    struct list_head held_fbs;
+    spinlock_t held_fbs_lock;
+    struct delayed_work held_fbs_work;
     atomic_t enable_event_handling;
 
     /**
