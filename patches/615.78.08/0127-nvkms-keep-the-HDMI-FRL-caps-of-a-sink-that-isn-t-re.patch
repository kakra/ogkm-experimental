             pSinkCaps->linkMaxFRLRateDSC = HDMI_FRL_DATA_RATE_NONE;
             return ret;
         }
-    } else if (bAssessedBefore) {
+    } else if (bAssessedBefore && (pSinkCaps->linkMaxFRLRate != HDMI_FRL_DATA_RATE_NONE)) {
