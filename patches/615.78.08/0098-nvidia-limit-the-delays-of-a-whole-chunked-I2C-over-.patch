From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kai Krakow <kai@kaishome.de>
Date: Mon, 2 Nov 2026 22:21:34 +0000
Subject: [PATCH] nvidia: limit the delays of a whole chunked I2C-over-AUX
 message

RmDpAuxI2CTransferChunked() restarts its defer and timeout limits with
every 16 byte AUX transaction. A sink that defers every transaction of
a long message can therefore keep rm_i2c_transfer() sleeping for
hundreds of milliseconds with the API and GPU locks held, which stalls
every other RM client, including the compositor.

Also count the delays of the whole message and give up with a timeout
after 64 of them. The per-transaction limits stay as they are. The
chunked path only runs when the I2C transfer control has failed.

Fixes: bba9d2ea ("nvidia: fall back to chunked I2C-over-AUX for i2c-dev DP transfers")
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/nvidia/arch/nvalloc/unix/src/osapi.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/nvidia/arch/nvalloc/unix/src/osapi.c b/src/nvidia/arch/nvalloc/unix/src/osapi.c
index 0545d9f0..7cda1e21 100644
--- a/src/nvidia/arch/nvalloc/unix/src/osapi.c
+++ b/src/nvidia/arch/nvalloc/unix/src/osapi.c
@@ -3965,6 +3965,12 @@ NvBool NV_API_CALL rm_is_supported_pci_device(
 //
 #define RM_DP_AUX_I2C_MAX_DEFERS   16
 #define RM_DP_AUX_I2C_MAX_TIMEOUTS 3
+//
+// The limits above restart with every AUX transaction of a message. Also limit
+// the delays of the whole message, so a sink that defers every transaction of
+// a long message can't hold the locks for hundreds of milliseconds.
+//
+#define RM_DP_AUX_I2C_MAX_DELAYS   64
 
 /*
  * Performs an I2C transfer over the DP AUX channel, split into AUX transactions.
@@ -3990,6 +3996,7 @@ static NV_STATUS RmDpAuxI2CTransferChunked
     NvU32      done     = 0;
     NvU32      defers   = 0;
     NvU32      timeouts = 0;
+    NvU32      delays   = 0;
 
     pParams = portMemAllocNonPaged(sizeof(*pParams));
     if (pParams == NULL)
@@ -4036,7 +4043,8 @@ static NV_STATUS RmDpAuxI2CTransferChunked
 
         if (status == NV_ERR_TIMEOUT)
         {
-            if (++timeouts >= RM_DP_AUX_I2C_MAX_TIMEOUTS)
+            if ((++timeouts >= RM_DP_AUX_I2C_MAX_TIMEOUTS) ||
+                (++delays > RM_DP_AUX_I2C_MAX_DELAYS))
             {
                 break;
             }
@@ -4082,7 +4090,8 @@ static NV_STATUS RmDpAuxI2CTransferChunked
 
         if (bDefer)
         {
-            if (++defers > RM_DP_AUX_I2C_MAX_DEFERS)
+            if ((++defers > RM_DP_AUX_I2C_MAX_DEFERS) ||
+                (++delays > RM_DP_AUX_I2C_MAX_DELAYS))
             {
                 status = NV_ERR_TIMEOUT;
                 break;
