From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Englund <tomenglund26@gmail.com>
Date: Sun, 1 Nov 2026 03:18:37 +0100
Subject: [PATCH] nvidia: clear ats_support when the kernel can't do SVA on new
 kernels too

The check that clears nv->ats_support without CONFIG_IOMMU_SVA sat inside
the #if for iommu_dev_enable_feature(), which recent kernels removed. On
those kernels a GPU with the ATS capability kept reporting ATS as
supported to RM and UVM, while os_iommu_sva_bind() was compiled to always
fail. Only the enable call depends on that symbol, so narrow the #if to it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernel-open/nvidia/nv-pci.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/kernel-open/nvidia/nv-pci.c b/kernel-open/nvidia/nv-pci.c
index 65b7a5de..696cbc32 100644
--- a/kernel-open/nvidia/nv-pci.c
+++ b/kernel-open/nvidia/nv-pci.c
@@ -2416,9 +2416,9 @@ nv_pci_probe_body
 
         NV_DEV_PRINTF(NV_DBG_INFO, nv, "ATS supported by this GPU!\n");
 
-#if NV_IS_EXPORT_SYMBOL_GPL_iommu_dev_enable_feature
 #if defined(CONFIG_IOMMU_SVA) && \
     (defined(NV_IOASID_GET_PRESENT) || defined(NV_MM_PASID_DROP_PRESENT))
+#if NV_IS_EXPORT_SYMBOL_GPL_iommu_dev_enable_feature
         ret = iommu_dev_enable_feature(nvl->dev, IOMMU_DEV_FEAT_SVA);
         if (ret == 0)
         {
@@ -2434,12 +2434,12 @@ nv_pci_probe_body
                           "Enabling SMMU SVA feature failed! ret: %d\n", ret);
             nv->ats_support = NV_FALSE;
         }
+#endif // NV_IS_EXPORT_SYMBOL_GPL_iommu_dev_enable_feature
 #else
         NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
                       "Enabling SMMU SVA feature failed due to lack of necessary kernel configs.\n");
         nv->ats_support = NV_FALSE;
 #endif
-#endif // NV_IS_EXPORT_SYMBOL_GPL_iommu_dev_enable_feature
     }
 
     if (pci_devid_is_self_hosted(pci_dev->device))
