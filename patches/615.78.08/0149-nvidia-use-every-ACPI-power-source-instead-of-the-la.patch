From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Englund <tomenglund26@gmail.com>
Date: Sun, 1 Nov 2026 02:42:55 +0100
Subject: [PATCH] nvidia: use every ACPI power source instead of the last _PSR
 found

nv_acpi_find_methods() kept only the last device with a _PSR. That device alone
got the notifier and decided the power source, and its _STA wasn't checked. On a
system with several sources, RM could stay on battery while AC was connected
through another one, and changes on the others weren't noticed.

Keep every device with a _PSR and put a notifier on each. AC is plugged in if
any source that is present is online, the same rule as
power_supply_is_system_supplied(). A source whose _PSR can't be read is skipped,
and the state is only unknown if none could be read.

A system that has a _PSR always reporting online now never goes on battery,
whereas before that depended on it being found last. Each read now also
evaluates _STA.

Booted on a laptop with one GPU and one _PSR, where unplugging and replugging AC
still moves the power limit. The case this fixes hasn't been run.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernel-open/nvidia/nv-acpi.c | 129 +++++++++++++++++++++++++++--------
 1 file changed, 100 insertions(+), 29 deletions(-)

diff --git a/kernel-open/nvidia/nv-acpi.c b/kernel-open/nvidia/nv-acpi.c
index 488ccdb2..0303ada0 100644
--- a/kernel-open/nvidia/nv-acpi.c
+++ b/kernel-open/nvidia/nv-acpi.c
@@ -49,9 +49,12 @@ static acpi_handle nvif_handle = NULL;
 static acpi_handle wmmx_handle = NULL;
 
 // Used for AC Power Source Hotplug Handling
-static acpi_handle psr_handle = NULL;
-static acpi_handle psr_device_handle = NULL;
-static nv_acpi_t  *psr_nv_acpi_object = NULL;
+#define NV_ACPI_MAX_PSR_DEVICES 8
+static struct {
+    acpi_handle device;
+    nv_acpi_t  *nv_acpi_object;
+} psr_devices[NV_ACPI_MAX_PSR_DEVICES];
+static u32 psr_device_count = 0;
 
 static NvBool battery_present = NV_FALSE;
 
@@ -122,13 +125,16 @@ static int nv_acpi_notifier_call_chain_handler(
 
 NV_STATUS NV_API_CALL nv_acpi_get_powersource(NvU32 *ac_plugged)
 {
-    unsigned long long val;
-    int status = 0;
+    NvBool source_read = NV_FALSE;
+    u32 count, i;
 
     if (!ac_plugged)
         return NV_ERR_INVALID_ARGUMENT;
 
-    if (!psr_device_handle)
+    // Paired with nv_acpi_add_psr_device()
+    count = smp_load_acquire(&psr_device_count);
+
+    if (count == 0)
     {
         // No _PSR: use the state cached from the power_supply class, if known
         int ac_state = atomic_read(&psy_ac_state);
@@ -140,15 +146,42 @@ NV_STATUS NV_API_CALL nv_acpi_get_powersource(NvU32 *ac_plugged)
         return NV_OK;
     }
 
-    // Check whether or not AC power is plugged in
-    status = acpi_evaluate_integer(psr_device_handle, "_PSR", NULL, &val);
-    if (ACPI_FAILURE(status))
+    //
+    // A system can have several power sources, or a _PSR on a device that isn't
+    // there. AC power is plugged in if any source that is present is online,
+    // the same rule as power_supply_is_system_supplied().
+    //
+    for (i = 0; i < count; i++)
+    {
+        acpi_handle handle = psr_devices[i].device;
+        unsigned long long sta, val;
+
+        // A device without _STA is present
+        if (ACPI_SUCCESS(acpi_evaluate_integer(handle, "_STA", NULL, &sta)) &&
+            !(sta & (ACPI_STA_DEVICE_PRESENT | ACPI_STA_DEVICE_FUNCTIONING)))
+        {
+            continue;
+        }
+
+        if (ACPI_FAILURE(acpi_evaluate_integer(handle, "_PSR", NULL, &val)))
+            continue;
+
+        source_read = NV_TRUE;
+
+        // AC Power Source Plug State
+        //  - 0x0 unplugged
+        //  - 0x1 plugged
+        if (val == 0x1)
+        {
+            *ac_plugged = 1;
+            return NV_OK;
+        }
+    }
+
+    if (!source_read)
         return NV_ERR_GENERIC;
 
-    // AC Power Source Plug State
-    //  - 0x0 unplugged
-    //  - 0x1 plugged
-    *ac_plugged = (val == 0x1);
+    *ac_plugged = 0;
 
     return NV_OK;
 }
@@ -305,6 +338,38 @@ static void nv_acpi_nvpcf_event(acpi_handle handle, u32 event_type, void *data)
  * End of ACPI event handler functions
  */
 
+static NvBool nv_acpi_is_psr_device(acpi_handle handle)
+{
+    u32 i;
+
+    for (i = 0; i < psr_device_count; i++)
+    {
+        if (psr_devices[i].device == handle)
+            return NV_TRUE;
+    }
+
+    return NV_FALSE;
+}
+
+/* The walk runs on every adapter init, so a device may already be known */
+static void nv_acpi_add_psr_device(acpi_handle handle)
+{
+    if (nv_acpi_is_psr_device(handle))
+        return;
+
+    if (psr_device_count == NV_ACPI_MAX_PSR_DEVICES)
+    {
+        nv_printf(NV_DBG_ERRORS, "NVRM: ignoring ACPI power source, too many _PSR devices\n");
+        return;
+    }
+
+    psr_devices[psr_device_count].device = handle;
+    psr_devices[psr_device_count].nv_acpi_object = NULL;
+
+    // Paired with nv_acpi_get_powersource(), which runs from notify handlers
+    smp_store_release(&psr_device_count, psr_device_count + 1);
+}
+
 /* Do the necessary allocations and install notifier "handler" on the device-node "device" */
 static nv_acpi_t* nv_install_notifier(
     struct acpi_handle *handle,
@@ -336,7 +401,7 @@ static nv_acpi_t* nv_install_notifier(
     pNvAcpiObject->sp = sp;
     pNvAcpiObject->notifier_data = notifier_data;
 
-    if (handle == psr_device_handle)
+    if (nv_acpi_is_psr_device(handle))
     {
         status = acpi_install_notify_handler(handle, ACPI_ALL_NOTIFY,
                   handler, pNvAcpiObject);
@@ -368,7 +433,7 @@ static void nv_uninstall_notifier(nv_acpi_t *pNvAcpiObject, acpi_notify_handler
 
     if (pNvAcpiObject && pNvAcpiObject->notify_handler_installed)
     {
-        if (pNvAcpiObject->handle == psr_device_handle)
+        if (nv_acpi_is_psr_device(pNvAcpiObject->handle))
         {
             status = acpi_remove_notify_handler(pNvAcpiObject->handle, ACPI_ALL_NOTIFY, handler);
         }
@@ -441,6 +506,8 @@ void nv_acpi_unregister_notifier(nv_linux_state_t *nvl)
 
 void NV_API_CALL nv_acpi_methods_init(NvU32 *handlesPresent)
 {
+    u32 i;
+
     if (!handlesPresent) // Caller passed us invalid pointer.
         return;
 
@@ -457,14 +524,14 @@ void NV_API_CALL nv_acpi_methods_init(NvU32 *handlesPresent)
     if (wmmx_handle)
         *handlesPresent = *handlesPresent | NV_ACPI_WMMX_HANDLE_PRESENT;
 
-    if (psr_handle)
+    // Since _PSR is not a per-GPU construct we only need to register a single
+    // notifier per power source. Skip registration for subsequent GPUs
+    for (i = 0; i < psr_device_count; i++)
     {
-        // Since _PSR is not a per-GPU construct we only need to register a
-        // single notifier for the _PSR event. Skip registration for subsequent
-        // devices
-        if (psr_nv_acpi_object == NULL)
+        if (psr_devices[i].nv_acpi_object == NULL)
         {
-            psr_nv_acpi_object = nv_install_notifier(psr_device_handle, nv_acpi_powersource_hotplug_event, NULL);
+            psr_devices[i].nv_acpi_object =
+                nv_install_notifier(psr_devices[i].device, nv_acpi_powersource_hotplug_event, NULL);
         }
     }
 
@@ -497,8 +564,7 @@ acpi_status nv_acpi_find_methods(
 
     if (!acpi_get_handle(handle, "_PSR", &method_handle))
     {
-        psr_handle = method_handle;
-        psr_device_handle = handle;
+        nv_acpi_add_psr_device(handle);
     }
 
     if (!acpi_get_handle(handle, "NPCF", &method_handle))
@@ -512,18 +578,23 @@ acpi_status nv_acpi_find_methods(
 
 void NV_API_CALL nv_acpi_methods_uninit(void)
 {
+    u32 i;
+
     nvif_handle = NULL;
     wmmx_handle = NULL;
 
-    if (psr_nv_acpi_object != NULL)
+    for (i = 0; i < psr_device_count; i++)
     {
-        nv_uninstall_notifier(psr_nv_acpi_object, nv_acpi_powersource_hotplug_event);
-
-        psr_handle = NULL;
-        psr_device_handle = NULL;
-        psr_nv_acpi_object = NULL;
+        if (psr_devices[i].nv_acpi_object != NULL)
+        {
+            nv_uninstall_notifier(psr_devices[i].nv_acpi_object, nv_acpi_powersource_hotplug_event);
+            psr_devices[i].nv_acpi_object = NULL;
+        }
     }
 
+    // The handles stay valid for a reader that still has the old count
+    smp_store_release(&psr_device_count, 0);
+
     if (nvpcf_nv_acpi_object != NULL)
     {
         nv_uninstall_notifier(nvpcf_nv_acpi_object, nv_acpi_nvpcf_event);
