From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Englund <tomenglund26@gmail.com>
Date: Fri, 16 Oct 2026 07:33:26 +0200
Subject: [PATCH] nvidia: free the GSP channel group when construction fails

The resource server doesn't run the destructor when construction fails,
so the channel group allocated on GSP by the RPC leaked and a retry with
the same handle failed with NV_ERR_INSERT_DUPLICATE_NAME. Free it on the
error path.
---
 .../gpu/fifo/kernel_channel_group_api.c       | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/src/nvidia/src/kernel/gpu/fifo/kernel_channel_group_api.c b/src/nvidia/src/kernel/gpu/fifo/kernel_channel_group_api.c
index f59bf0ee..3658e281 100644
--- a/src/nvidia/src/kernel/gpu/fifo/kernel_channel_group_api.c
+++ b/src/nvidia/src/kernel/gpu/fifo/kernel_channel_group_api.c
@@ -72,6 +72,7 @@ kchangrpapiConstruct_IMPL
     CTX_BUF_INFO                           *bufInfoList         = NULL;
     NvU32                                   bufCount            = 0;
     NvBool                                  bReserveMem         = NV_FALSE;
+    NvBool                                  bRpcAllocated       = NV_FALSE;
     MIG_INSTANCE_REF                        ref;
     RM_API                                 *pRmApi              = rmapiGetInterface(RMAPI_GPU_LOCK_INTERNAL);
     KernelChannelGroup                     *pKernelChannelGroup = NULL;
@@ -479,6 +480,8 @@ kchangrpapiConstruct_IMPL
             goto failed;
         }
 
+        bRpcAllocated = NV_TRUE;
+
         if (IS_VIRTUAL_WITH_FULL_SRIOV(pGpu) || IS_GSP_CLIENT(pGpu))
         {
             NVA06C_CTRL_INTERNAL_PROMOTE_FAULT_METHOD_BUFFERS_PARAMS params = {
@@ -561,6 +564,24 @@ failed:
                          pKernelChannelGroupApi->hKernelGraphicsContext);
         }
 
+        //
+        // The resource server does not run the destructor when construction
+        // fails, so the object allocated on the host/GSP by the RPC above must
+        // be freed here. Otherwise a retry with the same handle fails with
+        // NV_ERR_INSERT_DUPLICATE_NAME.
+        //
+        if (bRpcAllocated)
+        {
+            NV_STATUS tmpStatus = NV_OK;
+
+            NV_RM_RPC_FREE(pGpu,
+                           pParams->hClient,
+                           pParams->hParent,
+                           pParams->hResource,
+                           tmpStatus);
+            NV_ASSERT(tmpStatus == NV_OK);
+        }
+
         if (pKernelChannelGroup != NULL)
         {
             if (bTsgAllocated)
