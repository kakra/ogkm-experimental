 kernel-open/nvidia-drm/nvidia-drm-connector.c | 35 +++++++++++++++
 kernel-open/nvidia-drm/nvidia-drm-connector.h |  1 +
 kernel-open/nvidia-drm/nvidia-drm-drv.c       |  8 ++++
 src/nvidia-modeset/include/nvkms-types.h      |  1 +
