         NvBool *pLimited
     );
 
+    /*!
+     * Get whether HDMI FRL link training failed in the last modeset of a
+     * display, so that it doesn't show anything until the next successful one.
+     *
+     * \param [in]   device   A device returned by allocateDevice().
+     *
+     * \param [in]   display  The display to query.
+     *
+     * \param [out]  pFailed  Whether link training failed.
+     *
+     * \return NV_TRUE on success, NV_FALSE on failure.
+     */
+    NvBool (*getDisplayFrlLinkFailed)(
+        struct NvKmsKapiDevice *device,
+        NvKmsKapiDisplay display,
+        NvBool *pFailed
+    );
+
     /*!
      * Query where a head's raster generator reports its position, see
      * NVKMS_IOCTL_QUERY_HEAD_RASTER. Must be called from a context that can
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index f95cb0c3..25fc3ae3 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -1511,6 +1511,41 @@ bool nv_drm_connector_revoke_permissions(struct drm_device *dev,
     return ret;
 }
 
+/*
+ * Set a BAD link-status if HDMI FRL link training failed in the last modeset,
+ * which tells the compositor to set a mode again. Takes connection_mutex.
+ */
+void nv_drm_connector_update_link_status(struct drm_connector *connector)
+{
+    struct drm_device *dev = connector->dev;
+    struct nv_drm_device *nv_dev = to_nv_device(dev);
+    struct nv_drm_connector *nv_connector = to_nv_connector(connector);
+    NvBool failed = NV_FALSE;
+
+    if ((connector->connector_type != DRM_MODE_CONNECTOR_HDMIA) &&
+        (connector->connector_type != DRM_MODE_CONNECTOR_HDMIB)) {
+        return;
+    }
+
+    drm_modeset_lock(&dev->mode_config.connection_mutex, NULL);
+
+    if ((connector->state->crtc != NULL) &&
+        (nv_connector->nv_detected_encoder != NULL) &&
+        !nvKms->getDisplayFrlLinkFailed(
+            nv_dev->pDevice,
+            nv_connector->nv_detected_encoder->hDisplay,
+            &failed)) {
+        failed = NV_FALSE;
+    }
+
+    drm_modeset_unlock(&dev->mode_config.connection_mutex);
+
+    if (failed) {
+        drm_connector_set_link_status_property(connector,
+                                               DRM_MODE_LINK_STATUS_BAD);
+    }
+}
+
 void nv_drm_connector_update_content_protection(struct nv_drm_connector *nv_connector)
 {
 #ifdef NV_DRM_SUPPORT_CONTENT_PROTECTION_PROPERTY
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.h b/kernel-open/nvidia-drm/nvidia-drm-connector.h
index 4ff78005..eeaf7d7b 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-connector.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.h
@@ -149,6 +149,7 @@ nv_drm_get_connector(struct drm_device *dev,
 
 bool nv_drm_connector_revoke_permissions(struct drm_device *dev,
                                          struct nv_drm_connector *nv_connector);
+void nv_drm_connector_update_link_status(struct drm_connector *connector);
 void nv_drm_connector_update_content_protection(struct nv_drm_connector *nv_connector);
 int nv_drm_connector_update_topology_property(struct nv_drm_connector *nv_connector,
                                               const void *topology);
diff --git a/kernel-open/nvidia-drm/nvidia-drm-drv.c b/kernel-open/nvidia-drm/nvidia-drm-drv.c
index c52d7882..8a416afb 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-drv.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-drv.c
@@ -771,6 +771,14 @@ static void nv_drm_handle_hotplug_event(struct work_struct *work)
     struct delayed_work *dwork = to_delayed_work(work);
     struct nv_drm_device *nv_dev =
         container_of(dwork, struct nv_drm_device, hotplug_event_work);
+    struct drm_connector_list_iter conn_iter;
+    struct drm_connector *connector;
+
+    drm_connector_list_iter_begin(nv_dev->dev, &conn_iter);
+    drm_for_each_connector_iter(connector, &conn_iter) {
+        nv_drm_connector_update_link_status(connector);
+    }
+    drm_connector_list_iter_end(&conn_iter);
 
     drm_kms_helper_hotplug_event(nv_dev->dev);
 }
diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index e71dd0b5..478c28b8 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -2415,6 +2415,7 @@ typedef struct _NVDpyEvoRec {
         HDMI_SRC_CAPS srcCaps;
         HDMI_SINK_CAPS sinkCaps;
         NvBool reassessFrlLinkCaps             : 1;
+        NvU8 frlLinkFailures;
     } hdmi;
 
     struct {
diff --git a/src/nvidia-modeset/interface/nvkms-api.h b/src/nvidia-modeset/interface/nvkms-api.h
index c4e5a15b..bc3418c3 100644
--- a/src/nvidia-modeset/interface/nvkms-api.h
+++ b/src/nvidia-modeset/interface/nvkms-api.h
@@ -2790,6 +2790,12 @@ enum NvKmsDpyAttribute {
      * wouldn't raise it.
      */
     NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_LIMITED,
+
+    /*
+     * Whether HDMI FRL link training failed in the last modeset, so that the
+     * display doesn't show anything until the next successful one.
+     */
+    NV_KMS_DPY_ATTRIBUTE_HDMI_FRL_LINK_FAILED,
 };
 
 /*! Values for the NV_KMS_DPY_ATTRIBUTE_CONTENT_TYPE attribute. */
diff --git a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
index 56eb7b26..65cdead4 100644
--- a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
+++ b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
@@ -1758,6 +1758,24 @@ struct NvKmsKapiFunctionsTable {
         NvBool *pLimited
     );
 
+    /*!
+     * Get whether HDMI FRL link training failed in the last modeset of a
+     * display, so that it doesn't show anything until the next successful one.
+     *
+     * \param [in]   device   A device returned by allocateDevice().
+     *
+     * \param [in]   display  The display to query.
+     *
+     * \param [out]  pFailed  Whether link training failed.
+     *
+     * \return NV_TRUE on success, NV_FALSE on failure.
+     */
+    NvBool (*getDisplayFrlLinkFailed)(
+        struct NvKmsKapiDevice *device,
+        NvKmsKapiDisplay display,
+        NvBool *pFailed
+    );
+
     /*!
      * Query where a head's raster generator reports its position, see
      * NVKMS_IOCTL_QUERY_HEAD_RASTER. Must be called from a context that can
diff --git a/src/nvidia-modeset/kapi/src/nvkms-kapi.c b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
index 9df8eb41..f52e9dec 100644
--- a/src/nvidia-modeset/kapi/src/nvkms-kapi.c
+++ b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
@@ -3820,6 +3820,28 @@ static NvBool GetDisplayColorBpc(
     return NV_TRUE;
 }
 
+static NvBool GetDisplayFrlLinkFailed(
+    struct NvKmsKapiDevice *device,
+    NvKmsKapiDisplay display,
+    NvBool *pFailed)
+{
+    NvS64 failed;
+
+    if (device->hKmsDevice == 0x0) {
+        return NV_FALSE;
+    }
+
+    if (!GetDisplayAttribute(device, display,
+                             NV_KMS_DPY_ATTRIBUTE_HDMI_FRL_LINK_FAILED,
+                             &failed)) {
+        return NV_FALSE;
+    }
+
+    *pFailed = (failed != 0);
+
+    return NV_TRUE;
+}
+
 static NvBool KmsSetMode(
     struct NvKmsKapiDevice *device,
     const struct NvKmsKapiRequestedModeSetConfig *requestedConfig,
@@ -4786,6 +4808,7 @@ NvBool nvKmsKapiGetFunctionsTableInternal
     funcsTable->perfBoost = RmPerfBoost;
 
     funcsTable->getDisplayColorBpc = GetDisplayColorBpc;
+    funcsTable->getDisplayFrlLinkFailed = GetDisplayFrlLinkFailed;
 
     funcsTable->getHeadRaster = GetHeadRaster;
 
diff --git a/src/nvidia-modeset/src/nvkms-attributes.c b/src/nvidia-modeset/src/nvkms-attributes.c
index 6fa8ba57..fa0cb797 100644
--- a/src/nvidia-modeset/src/nvkms-attributes.c
+++ b/src/nvidia-modeset/src/nvkms-attributes.c
@@ -867,6 +867,12 @@ static NvBool GetCurrentColorBpcLimited(const NVDpyEvoRec *pDpyEvo,
     return TRUE;
 }
 
+static NvBool GetHdmiFrlLinkFailed(const NVDpyEvoRec *pDpyEvo, NvS64 *pValue)
+{
+    *pValue = (pDpyEvo->hdmi.frlLinkFailures != 0);
+    return TRUE;
+}
+
 static NvBool GetRequestedColorBpcMaxValidValues(
     const NVDpyEvoRec *pDpyEvo,
     struct NvKmsAttributeValidValuesCommonReply *pValidValues)
@@ -1469,6 +1475,12 @@ static const struct {
         .getValidValues = NULL,
         .type           = NV_KMS_ATTRIBUTE_TYPE_BOOLEAN,
     },
+    [NV_KMS_DPY_ATTRIBUTE_HDMI_FRL_LINK_FAILED] = {
+        .set            = NULL,
+        .get            = GetHdmiFrlLinkFailed,
+        .getValidValues = NULL,
+        .type           = NV_KMS_ATTRIBUTE_TYPE_BOOLEAN,
+    },
 };
 
 /*!
diff --git a/src/nvidia-modeset/src/nvkms-dpy.c b/src/nvidia-modeset/src/nvkms-dpy.c
index 3815fe8e..b83a2877 100644
--- a/src/nvidia-modeset/src/nvkms-dpy.c
+++ b/src/nvidia-modeset/src/nvkms-dpy.c
@@ -977,6 +977,7 @@ void nvDpyProbeMaxPixelClock(NVDpyEvoPtr pDpyEvo)
 
             nvkms_memset(&pDpyEvo->hdmi.srcCaps, 0, sizeof(pDpyEvo->hdmi.srcCaps));
             nvkms_memset(&pDpyEvo->hdmi.sinkCaps, 0, sizeof(pDpyEvo->hdmi.sinkCaps));
+            pDpyEvo->hdmi.frlLinkFailures = 0;
 
             if (nvHdmiDpySupportsFrl(pDpyEvo)) {
                 /*
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index ee33972c..fe3148b3 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -31,6 +31,7 @@
 #include "nvkms-hdmi.h"
 #include "nvkms-evo.h"
 #include "nvkms-modepool.h"
+#include "nvkms-private.h"
 #include "nvkms-rmapi.h"
 #include "nvkms-types.h"
 #include "nvkms-utils.h"
@@ -2813,6 +2814,39 @@ static enum NvKmsFrlRateForce GetForceMaxFrlRateType(
     return NVKMS_FRL_RATE_FORCE_NONE;
 }
 
+/*
+ * Track failed FRL link training of a modeset. The display stays black after
+ * a failure, and nothing else tells the clients: reassess the link and send
+ * them a dpy event, which nvidia-drm turns into a BAD link-status so that the
+ * compositor sets a mode again. Give up after a few failures in a row, so that
+ * a link that keeps failing doesn't cause modesets forever.
+ */
+static void HandleFrlLinkTrainingResult(NVDispEvoPtr pDispEvo,
+                                        const NVConnectorEvoRec *pConnectorEvo,
+                                        NvBool trained)
+{
+    const NvU8 MAX_REPORTED_FAILURES = 3;
+    NVDpyEvoPtr pDpyEvo =
+        nvGetDpyEvoFromDispEvo(pDispEvo, pConnectorEvo->displayId);
+
+    if (pDpyEvo == NULL) {
+        return;
+    }
+
+    if (trained) {
+        pDpyEvo->hdmi.frlLinkFailures = 0;
+        return;
+    }
+
+    if (pDpyEvo->hdmi.frlLinkFailures >= MAX_REPORTED_FAILURES) {
+        return;
+    }
+
+    pDpyEvo->hdmi.frlLinkFailures++;
+    pDpyEvo->hdmi.reassessFrlLinkCaps = TRUE;
+    nvSendDpyEventEvo(pDpyEvo, NVKMS_EVENT_TYPE_DPY_CHANGED);
+}
+
 void nvHdmiFrlSetConfig(NVDispEvoRec *pDispEvo, NvU32 head)
 {
     const NVDevEvoRec *pDevEvo = pDispEvo->pDevEvo;
@@ -2822,6 +2856,7 @@ void nvHdmiFrlSetConfig(NVDispEvoRec *pDispEvo, NvU32 head)
     NVHDMIPKT_RESULT ret;
     NvU32 retries = 0;
     const NvU32 MAX_RETRIES = 5;
+    NvBool trained;
 
     if (pFrlConfig->frlRate == HDMI_FRL_DATA_RATE_NONE) {
         return;
@@ -2830,6 +2865,11 @@ void nvHdmiFrlSetConfig(NVDispEvoRec *pDispEvo, NvU32 head)
     nvAssert(pHeadState->activeRmId != 0);
 
     do {
+        /* Give the sink time to get ready for link training again. */
+        if (retries != 0) {
+            nvkms_usleep(200000);
+        }
+
         ret = NvHdmi_SetFRLConfig(pDevEvo->hdmiLib.handle,
                                   pDispEvo->displayOwner,
                                   pHeadState->activeRmId,
@@ -2837,6 +2877,8 @@ void nvHdmiFrlSetConfig(NVDispEvoRec *pDispEvo, NvU32 head)
                                   pFrlConfig);
     } while (ret != NVHDMIPKT_SUCCESS && retries++ < MAX_RETRIES);
 
+    trained = (ret == NVHDMIPKT_SUCCESS);
+
     if (ret != NVHDMIPKT_SUCCESS) {
         nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
                      "HDMI FRL link training failed.");
@@ -2866,4 +2908,6 @@ void nvHdmiFrlSetConfig(NVDispEvoRec *pDispEvo, NvU32 head)
                           "HDMI FRL link training retried %d times.",
                           retries);
     }
+
+    HandleFrlLinkTrainingResult(pDispEvo, pHeadState->pConnectorEvo, trained);
 }
