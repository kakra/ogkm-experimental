From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kai Krakow <kai@kaishome.de>
Date: Sat, 24 Oct 2026 15:04:54 +0200
Subject: [PATCH] nvidia: let sysmem allocations with a fallback fail fast at
 high order

nv_compute_gfp_mask() sets __GFP_RETRY_MAYFAIL for every sysmem
allocation. The flag was chosen to keep the OOM killer away, which is
right for order-0 pages. For costly orders the page allocator never
invokes the OOM killer anyway; there __GFP_RETRY_MAYFAIL only makes it
retry direct reclaim and compaction up to MAX_COMPACT_RETRIES times
with rising priority before it gives up.

Several callers ask for big pages first and retry with smaller pages
when that fails, e.g. UVM for its pushbuffers and channels
(uvm_rm_mem_alloc()) and the client shadow fault buffer. On a desktop
with fragmented memory there is often no free order-9 block at all, so
the first attempt fails anyway, but only after it stalled the caller
in compaction. This shows up as stutter when a game or a Vulkan
process starts, and it adds to the compact_stall/compact_fail counts.

UVM's own CPU chunk allocator already uses __GFP_NORETRY for
allocations above PAGE_SIZE for this reason (uvm_pmm_sysmem.c).

Add MEMDESC_FLAGS_ALLOC_FAIL_FAST so that a caller with a fallback can
say so. osAllocPagesInternal() passes it to nv_alloc_pages(), which
records it in nv_alloc_t, and nv_compute_gfp_mask() then uses
__GFP_NORETRY instead of __GFP_RETRY_MAYFAIL for orders above 0.
Order-0 allocations keep __GFP_RETRY_MAYFAIL. Nothing sets the flag
yet.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
(cherry picked from commit dab187ff9575dbe1cc1a9747065dbe8230ac65ca)
---
 kernel-open/common/inc/nv-linux.h         | 1 +
 kernel-open/common/inc/nv.h               | 2 +-
 kernel-open/nvidia/nv-vm.c                | 9 ++++++++-
 kernel-open/nvidia/nv.c                   | 3 +++
 src/nvidia/arch/nvalloc/unix/include/nv.h | 2 +-
 src/nvidia/arch/nvalloc/unix/src/os.c     | 1 +
 src/nvidia/generated/g_mem_desc_nvoc.h    | 6 ++++++
 7 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/kernel-open/common/inc/nv-linux.h b/kernel-open/common/inc/nv-linux.h
index ca4dbdae..d68095a8 100644
--- a/kernel-open/common/inc/nv-linux.h
+++ b/kernel-open/common/inc/nv-linux.h
@@ -947,6 +947,7 @@ typedef struct nv_alloc_s {
         NvBool coherent    : 1;
         NvBool carveout    : 1;
         NvBool pool        : 1;
+        NvBool fail_fast   : 1;
     } flags;
     unsigned int   cache_type;
     unsigned int   num_pages;
diff --git a/kernel-open/common/inc/nv.h b/kernel-open/common/inc/nv.h
index 2731195b..566933c3 100644
--- a/kernel-open/common/inc/nv.h
+++ b/kernel-open/common/inc/nv.h
@@ -972,7 +972,7 @@ nv_state_t*  NV_API_CALL  nv_get_ctl_state       (void);
 void   NV_API_CALL  nv_set_dma_address_size      (nv_state_t *, NvU32 );
 
 NV_STATUS  NV_API_CALL  nv_alias_pages           (nv_state_t *, NvU32, NvU64, NvU32, NvU32, NvU64, NvU64 *, NvBool, void **);
-NV_STATUS  NV_API_CALL  nv_alloc_pages           (nv_state_t *, NvU32, NvU64, NvBool, NvU32, NvBool, NvBool, NvS32, NvU64 *, void **);
+NV_STATUS  NV_API_CALL  nv_alloc_pages           (nv_state_t *, NvU32, NvU64, NvBool, NvU32, NvBool, NvBool, NvBool, NvS32, NvU64 *, void **);
 NV_STATUS  NV_API_CALL  nv_free_pages            (nv_state_t *, NvU32, NvBool, NvU32, void *);
 
 NV_STATUS  NV_API_CALL  nv_register_user_pages   (nv_state_t *, NvU64, NvU64 *, void *, void **, NvBool);
diff --git a/kernel-open/nvidia/nv-vm.c b/kernel-open/nvidia/nv-vm.c
index 2f0043ee..f1902973 100644
--- a/kernel-open/nvidia/nv-vm.c
+++ b/kernel-open/nvidia/nv-vm.c
@@ -310,7 +310,14 @@ static unsigned int nv_compute_gfp_mask(
         }
     }
 
-    gfp_mask |= __GFP_RETRY_MAYFAIL;
+    /*
+     * The caller of a fail_fast allocation retries with smaller pages, so
+     * don't stall in direct reclaim and compaction for high-order pages.
+     */
+    if (at->flags.fail_fast && (at->order > 0))
+        gfp_mask |= __GFP_NORETRY;
+    else
+        gfp_mask |= __GFP_RETRY_MAYFAIL;
 
     /*
      * __GFP_ACCOUNT is used to track/account for allocations with cgroups. The first attempt
diff --git a/kernel-open/nvidia/nv.c b/kernel-open/nvidia/nv.c
index ae29b047..bc1adcad 100644
--- a/kernel-open/nvidia/nv.c
+++ b/kernel-open/nvidia/nv.c
@@ -4145,6 +4145,7 @@ NV_STATUS NV_API_CALL nv_alloc_pages(
     NvU32       cache_type,
     NvBool      zeroed,
     NvBool      unencrypted,
+    NvBool      fail_fast,
     NvS32       node_id,
     NvU64      *pte_array,
     void      **priv_data
@@ -4191,6 +4192,8 @@ NV_STATUS NV_API_CALL nv_alloc_pages(
 #endif
     if (unencrypted)
         at->flags.unencrypted = NV_TRUE;
+    if (fail_fast)
+        at->flags.fail_fast = NV_TRUE;
 
     if (node_id != NUMA_NO_NODE)
     {
diff --git a/src/nvidia/arch/nvalloc/unix/include/nv.h b/src/nvidia/arch/nvalloc/unix/include/nv.h
index ba72129e..069faae2 100644
--- a/src/nvidia/arch/nvalloc/unix/include/nv.h
+++ b/src/nvidia/arch/nvalloc/unix/include/nv.h
@@ -972,7 +972,7 @@ nv_state_t*  NV_API_CALL  nv_get_ctl_state       (void);
 void   NV_API_CALL  nv_set_dma_address_size      (nv_state_t *, NvU32 );
 
 NV_STATUS  NV_API_CALL  nv_alias_pages           (nv_state_t *, NvU32, NvU64, NvU32, NvU32, NvU64, NvU64 *, NvBool, void **);
-NV_STATUS  NV_API_CALL  nv_alloc_pages           (nv_state_t *, NvU32, NvU64, NvBool, NvU32, NvBool, NvBool, NvS32, NvU64 *, void **);
+NV_STATUS  NV_API_CALL  nv_alloc_pages           (nv_state_t *, NvU32, NvU64, NvBool, NvU32, NvBool, NvBool, NvBool, NvS32, NvU64 *, void **);
 NV_STATUS  NV_API_CALL  nv_free_pages            (nv_state_t *, NvU32, NvBool, NvU32, void *);
 
 NV_STATUS  NV_API_CALL  nv_register_user_pages   (nv_state_t *, NvU64, NvU64 *, void *, void **, NvBool);
diff --git a/src/nvidia/arch/nvalloc/unix/src/os.c b/src/nvidia/arch/nvalloc/unix/src/os.c
index faa5e25c..3f1da8a8 100644
--- a/src/nvidia/arch/nvalloc/unix/src/os.c
+++ b/src/nvidia/arch/nvalloc/unix/src/os.c
@@ -1072,6 +1072,7 @@ NV_STATUS osAllocPagesInternal(
             pSys->getProperty(pSys,
                 PDB_PROP_SYS_INITIALIZE_SYSTEM_MEMORY_ALLOCATIONS),
             unencrypted,
+            memdescGetFlag(pMemDesc, MEMDESC_FLAGS_ALLOC_FAIL_FAST),
             nodeId,
             memdescGetPteArray(pMemDesc, AT_CPU),
             &pMemData);
diff --git a/src/nvidia/generated/g_mem_desc_nvoc.h b/src/nvidia/generated/g_mem_desc_nvoc.h
index cdee92f4..2180c9ac 100644
--- a/src/nvidia/generated/g_mem_desc_nvoc.h
+++ b/src/nvidia/generated/g_mem_desc_nvoc.h
@@ -420,6 +420,12 @@ typedef struct ADDRESS_TRANSLATION_ *ADDRESS_TRANSLATION;
 // Indicate if FABRIC_V2 memdesc can be mapped to have traffic over NVLink fabric loopback.
 #define MEMDESC_FLAGS_ALLOW_FABRIC_LOOPBACK_MAPPING NVBIT64(56)
 
+//
+// The caller retries a failed sysmem allocation with a smaller page size.
+// Don't make the OS reclaim or compact memory hard for high-order pages.
+//
+#define MEMDESC_FLAGS_ALLOC_FAIL_FAST              NVBIT64(57)
+
 //
 // RM internal allocations owner tags
 // Total 200 tags are introduced, out of which some are already
