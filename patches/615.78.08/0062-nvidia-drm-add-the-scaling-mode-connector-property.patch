 kernel-open/nvidia-drm/nvidia-drm-crtc.c      |  12 +-
 kernel-open/nvidia-drm/nvidia-drm-encoder.c   |  96 +++++++++++++-
 kernel-open/nvidia-drm/nvidia-drm-linux.c     |   6 +
 .../nvidia-drm/nvidia-drm-os-interface.c      |   1 +
 .../nvidia-drm/nvidia-drm-os-interface.h      |   2 +
 .../kapi/interface/nvkms-kapi.h               |  11 ++
 src/nvidia-modeset/kapi/src/nvkms-kapi.c      |  14 ++-
