 (
@@ -154,6 +95,4 @@ kheadHandleRgSemIntr_v04_01
             kdispNotifyEvent(pGpu, pKernelDisplay, NVC370_NOTIFIERS_RG_SEM_NOTIFICATION, &params, sizeof(params), 0, 0);
