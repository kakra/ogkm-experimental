From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Englund <tomenglund26@gmail.com>
Date: Sat, 31 Oct 2026 17:07:04 +0100
Subject: [PATCH] nvidia-drm: add a switch to the GEM allocation back-off and
 let it decay

The back-off only reset on a successful allocation it would have held back, so
one failure long after a burst of them was held back for the full 2 s. Start
over at the shortest delay when the last back-off ended more than 10 s ago. A
client retrying every frame stays at the longest delay, as its next attempt
comes right when the back-off ends.

Add a runtime switch. Rollback:
/sys/module/nvidia_drm/parameters/gem_alloc_backoff = 0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernel-open/nvidia-drm/nvidia-drm-gem-nvkms-memory.c | 11 ++++++++++-
 kernel-open/nvidia-drm/nvidia-drm-linux.c            |  6 ++++++
 kernel-open/nvidia-drm/nvidia-drm-os-interface.c     |  1 +
 kernel-open/nvidia-drm/nvidia-drm-os-interface.h     |  2 ++
 4 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-gem-nvkms-memory.c b/kernel-open/nvidia-drm/nvidia-drm-gem-nvkms-memory.c
index 639b92e3..b8fd7f7b 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-gem-nvkms-memory.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-gem-nvkms-memory.c
@@ -637,12 +637,20 @@ done:
 
 #define NV_DRM_GEM_ALLOC_BACKOFF_MIN_MS 100
 #define NV_DRM_GEM_ALLOC_BACKOFF_MAX_MS 2000
+/* Start over after this long past the end of the last back-off */
+#define NV_DRM_GEM_ALLOC_BACKOFF_RESET_MS 10000
 
 static void nv_drm_gem_alloc_failed(struct nv_drm_file *nv_file,
                                     u64 size, bool scanout)
 {
     unsigned int delay_ms = nv_file->gem_alloc_fail_delay_ms;
 
+    if (delay_ms != 0 &&
+        time_after(jiffies, nv_file->gem_alloc_fail_until +
+                            msecs_to_jiffies(NV_DRM_GEM_ALLOC_BACKOFF_RESET_MS))) {
+        delay_ms = 0;
+    }
+
     delay_ms = (delay_ms == 0) ? NV_DRM_GEM_ALLOC_BACKOFF_MIN_MS :
                min(delay_ms * 2, (unsigned int)NV_DRM_GEM_ALLOC_BACKOFF_MAX_MS);
 
@@ -701,7 +709,8 @@ int nv_drm_gem_alloc_nvkms_memory_ioctl(struct drm_device *dev,
      * an allocation resets it. A failed scanout allocation doesn't hold back
      * offscreen ones, which can still fall back to sysmem.
      */
-    if (nv_file->gem_alloc_fail_size != 0 &&
+    if (nv_drm_gem_alloc_backoff_module_param &&
+        nv_file->gem_alloc_fail_size != 0 &&
         nv_drm_gem_alloc_covers_failed(nv_file, p->memory_size, scanout) &&
         time_before(jiffies, nv_file->gem_alloc_fail_until)) {
         ret = -ENOMEM;
diff --git a/kernel-open/nvidia-drm/nvidia-drm-linux.c b/kernel-open/nvidia-drm/nvidia-drm-linux.c
index e6e385f6..f88dc61a 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-linux.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-linux.c
@@ -79,6 +79,12 @@ MODULE_PARM_DESC(
     "times (1 = enable (default), 0 = disable)");
 module_param_named(hw_raster, nv_drm_hw_raster_module_param, bool, 0644);
 
+MODULE_PARM_DESC(
+    gem_alloc_backoff,
+    "Fail repeated GEM allocations of a client that are bound to fail again "
+    "without trying (1 = enable (default), 0 = disable)");
+module_param_named(gem_alloc_backoff, nv_drm_gem_alloc_backoff_module_param, bool, 0644);
+
 #endif /* NV_DRM_AVAILABLE */
 
 /*************************************************************************
diff --git a/kernel-open/nvidia-drm/nvidia-drm-os-interface.c b/kernel-open/nvidia-drm/nvidia-drm-os-interface.c
index 5726de2d..613b3157 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-os-interface.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-os-interface.c
@@ -50,6 +50,7 @@ bool nv_drm_deadline_boost_module_param = true;
 bool nv_drm_scaling_mode_module_param = true;
 bool nv_drm_vrr_flip_timestamps_module_param = true;
 bool nv_drm_hw_raster_module_param = true;
+bool nv_drm_gem_alloc_backoff_module_param = true;
 
 void *nv_drm_calloc(size_t nmemb, size_t size)
 {
diff --git a/kernel-open/nvidia-drm/nvidia-drm-os-interface.h b/kernel-open/nvidia-drm/nvidia-drm-os-interface.h
index 5ff4ba04..0fa812db 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-os-interface.h
+++ b/kernel-open/nvidia-drm/nvidia-drm-os-interface.h
@@ -78,6 +78,8 @@ extern bool nv_drm_scaling_mode_module_param;
 extern bool nv_drm_vrr_flip_timestamps_module_param;
 /* Set to true when vblank counts and VRR flip times come from the raster position register. */
 extern bool nv_drm_hw_raster_module_param;
+/* Set to true when repeated failed GEM allocations of a client are held back. */
+extern bool nv_drm_gem_alloc_backoff_module_param;
 
 void *nv_drm_calloc(size_t nmemb, size_t size);
 
