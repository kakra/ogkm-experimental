 NV_CONFTEST_TYPE_COMPILE_TESTS += drm_file_get_master
 NV_CONFTEST_TYPE_COMPILE_TESTS += drm_modeset_lock_all_end
 NV_CONFTEST_TYPE_COMPILE_TESTS += drm_driver_has_dumb_destroy
diff --git a/src/nvidia-modeset/include/nvkms-evo.h b/src/nvidia-modeset/include/nvkms-evo.h
index 63cc8b95..a656f7f6 100644
--- a/src/nvidia-modeset/include/nvkms-evo.h
+++ b/src/nvidia-modeset/include/nvkms-evo.h
@@ -196,6 +196,10 @@ NvBool nvDowngradeColorFormatAndBpc(
     const NvBool colorBpcSpecified,
     NVDpyAttributeColor *pDpyColor);
 
+void nvLimitColorBpcEvo(const NVDpyEvoRec *pDpyEvo,
+                        enum NvKmsDpyAttributeColorBpcValue maxBpc,
+                        NVDpyAttributeColor *pDpyColor);
+
 NvBool nvDPValidateModeEvo(NVDpyEvoPtr pDpyEvo,
                            NVHwModeTimingsEvoPtr pTimings,
                            const NvBool colorFormatSpecified,
diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index 25d57743..f66c857b 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -2355,6 +2355,9 @@ typedef struct _NVDpyEvoRec {
     enum NvKmsDpyAttributeRequestedColorFormatValue requestedColorFormat;
     enum NvKmsDpyAttributeColorRangeValue requestedColorRange;
 
+    /* NV_KMS_DPY_ATTRIBUTE_REQUESTED_COLOR_BPC_MAX; UNKNOWN for no limit */
+    enum NvKmsDpyAttributeColorBpcValue requestedColorBpcMax;
+
     NVAttributesSetEvoRec currentAttributes;
 
     nvkms_timer_handle_t *hdrToSdrTransitionTimer;
diff --git a/src/nvidia-modeset/interface/nvkms-api.h b/src/nvidia-modeset/interface/nvkms-api.h
index f92317ac..822e8b8e 100644
--- a/src/nvidia-modeset/interface/nvkms-api.h
+++ b/src/nvidia-modeset/interface/nvkms-api.h
@@ -2761,6 +2761,16 @@ enum NvKmsDpyAttribute {
     NV_KMS_DPY_ATTRIBUTE_DISPLAYPORT_SINK_IS_AUDIO_CAPABLE,
 
     NV_KMS_DPY_ATTRIBUTE_NUMBER_OF_HARDWARE_HEADS_USED,
+
+    /*
+     * Upper limit for the output color bpc, like the DRM "max bpc" connector
+     * property. Takes an NvKmsDpyAttributeColorBpcValue;
+     * NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_UNKNOWN means no limit. Applied
+     * by the next modeset that doesn't request a specific bpc: NVKMS then
+     * picks the highest bpc up to the limit that the display and the link
+     * support, but never less than the colorimetry requires.
+     */
+    NV_KMS_DPY_ATTRIBUTE_REQUESTED_COLOR_BPC_MAX,
 };
 
 /*
diff --git a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
index 4d6d5b3c..4f96715c 100644
--- a/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
+++ b/src/nvidia-modeset/kapi/interface/nvkms-kapi.h
@@ -425,6 +425,13 @@ struct NvKmsKapiHeadModeSetConfig {
      */
     NvBool limitedColorRange;
 
+    /*
+     * Upper limit for the output bpc of the displays (6, 8, 10 or 12), 0 for
+     * no limit; the DRM "max bpc" property. NVKMS picks the highest bpc up to
+     * it that the display and the link support.
+     */
+    NvU8 maxBpc;
+
     NvBool postcompColorPassthrough;
 };
 
@@ -440,6 +447,7 @@ struct NvKmsKapiHeadRequestedConfig {
         NvBool olutFpNormScaleChanged          : 1;
         NvBool ditheringChanged                : 1;
         NvBool colorRangeChanged               : 1;
+        NvBool maxBpcChanged                   : 1;
         NvBool hdmiVsifMetadataChanged         : 1;
         NvBool postcompColorPassthroughChanged : 1;
     } flags;
@@ -1696,6 +1704,27 @@ struct NvKmsKapiFunctionsTable {
         const struct NvKmsKapiDevice *device,
         NvU32 durationSec
     );
+
+    /*!
+     * Query the output color bpc that a display is currently driven with,
+     * and the bpc limit stored for it.
+     *
+     * \param [in]  device   A device allocated using allocateDevice().
+     *
+     * \param [in]  display  The display to query.
+     *
+     * \param [out] pBpc     The current bpc, 0 if unknown.
+     *
+     * \param [out] pMaxBpc  The bpc limit, 0 for none.
+     *
+     * \return NV_TRUE on success, NV_FALSE on failure.
+     */
+    NvBool (*getDisplayColorBpc)(
+        struct NvKmsKapiDevice *device,
+        NvKmsKapiDisplay display,
+        NvU32 *pBpc,
+        NvU32 *pMaxBpc
+    );
 };
 
 /** @} */
diff --git a/src/nvidia-modeset/kapi/src/nvkms-kapi.c b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
index f5c8316f..b235785c 100644
--- a/src/nvidia-modeset/kapi/src/nvkms-kapi.c
+++ b/src/nvidia-modeset/kapi/src/nvkms-kapi.c
@@ -3648,6 +3648,104 @@ static void SetRequestedColorRange(
     }
 }
 
+/*
+ * Store the requested bpc limit on the displays. Like the color range, the
+ * modeset that follows applies it, and a limit can't make a mode fail that
+ * passes without it, so a TEST_ONLY check skips it.
+ */
+static void SetRequestedColorBpcMax(
+    struct NvKmsKapiDevice *device,
+    const struct NvKmsKapiRequestedModeSetConfig *requestedConfig)
+{
+    NvU32 head;
+
+    for (head = 0;
+         head < ARRAY_LEN(requestedConfig->headRequestedConfig); head++) {
+
+        const struct NvKmsKapiHeadRequestedConfig *headRequestedConfig =
+            &requestedConfig->headRequestedConfig[head];
+        const struct NvKmsKapiHeadModeSetConfig *headModeSetConfig =
+            &headRequestedConfig->modeSetConfig;
+        NvU32 i;
+
+        if ((requestedConfig->headsMask & (1 << head)) == 0x0 ||
+            !headRequestedConfig->flags.maxBpcChanged) {
+            continue;
+        }
+
+        for (i = 0; i < headModeSetConfig->numDisplays; i++) {
+            struct NvKmsSetDpyAttributeParams params = { };
+
+            params.request.deviceHandle = device->hKmsDevice;
+            params.request.dispHandle = device->hKmsDisp;
+            params.request.dpyId =
+                nvNvU32ToDpyId(headModeSetConfig->displays[i]);
+            params.request.attribute =
+                NV_KMS_DPY_ATTRIBUTE_REQUESTED_COLOR_BPC_MAX;
+            params.request.value = headModeSetConfig->maxBpc;
+
+            if (!nvkms_ioctl_from_kapi_try_pmlock(device->pKmsOpen,
+                                                  NVKMS_IOCTL_SET_DPY_ATTRIBUTE,
+                                                  &params, sizeof(params))) {
+                nvKmsKapiLogDeviceDebug(
+                    device,
+                    "Failed to set the bpc limit of display 0x%08x",
+                    headModeSetConfig->displays[i]);
+            }
+        }
+    }
+}
+
+static NvBool GetDisplayAttribute(
+    struct NvKmsKapiDevice *device,
+    NvKmsKapiDisplay display,
+    enum NvKmsDpyAttribute attribute,
+    NvS64 *pValue)
+{
+    struct NvKmsGetDpyAttributeParams params = { };
+
+    params.request.deviceHandle = device->hKmsDevice;
+    params.request.dispHandle = device->hKmsDisp;
+    params.request.dpyId = nvNvU32ToDpyId(display);
+    params.request.attribute = attribute;
+
+    if (!nvkms_ioctl_from_kapi(device->pKmsOpen,
+                               NVKMS_IOCTL_GET_DPY_ATTRIBUTE,
+                               &params, sizeof(params))) {
+        return NV_FALSE;
+    }
+
+    *pValue = params.reply.value;
+
+    return NV_TRUE;
+}
+
+static NvBool GetDisplayColorBpc(
+    struct NvKmsKapiDevice *device,
+    NvKmsKapiDisplay display,
+    NvU32 *pBpc,
+    NvU32 *pMaxBpc)
+{
+    NvS64 bpc, maxBpc;
+
+    if (device->hKmsDevice == 0x0) {
+        return NV_FALSE;
+    }
+
+    if (!GetDisplayAttribute(device, display,
+                             NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC, &bpc) ||
+        !GetDisplayAttribute(device, display,
+                             NV_KMS_DPY_ATTRIBUTE_REQUESTED_COLOR_BPC_MAX,
+                             &maxBpc)) {
+        return NV_FALSE;
+    }
+
+    *pBpc = bpc;
+    *pMaxBpc = maxBpc;
+
+    return NV_TRUE;
+}
+
 static NvBool KmsSetMode(
     struct NvKmsKapiDevice *device,
     const struct NvKmsKapiRequestedModeSetConfig *requestedConfig,
@@ -3673,6 +3771,7 @@ static NvBool KmsSetMode(
     /* The range can't make a modeset fail, so a TEST_ONLY check skips it */
     if (commit) {
         SetRequestedColorRange(device, requestedConfig);
+        SetRequestedColorBpcMax(device, requestedConfig);
     }
 
     status = nvkms_ioctl_from_kapi_try_pmlock(device->pKmsOpen,
@@ -4423,6 +4522,8 @@ NvBool nvKmsKapiGetFunctionsTableInternal
 
     funcsTable->perfBoost = RmPerfBoost;
 
+    funcsTable->getDisplayColorBpc = GetDisplayColorBpc;
+
     return NV_TRUE;
 }
 
diff --git a/src/nvidia-modeset/src/nvkms-attributes.c b/src/nvidia-modeset/src/nvkms-attributes.c
index 0512dccc..b97e996a 100644
--- a/src/nvidia-modeset/src/nvkms-attributes.c
+++ b/src/nvidia-modeset/src/nvkms-attributes.c
@@ -498,6 +498,20 @@ static void DpyPostColorFormatOrRangeSetEvo(NVDpyEvoPtr pDpyEvo)
         return;
     }
 
+    {
+        NVDpyAttributeColor limitedDpyColor = pApiHeadState->attributes.color;
+
+        limitedDpyColor.format = colorFormat;
+        limitedDpyColor.bpc = colorBpc;
+        limitedDpyColor.range = colorRange;
+
+        nvLimitColorBpcEvo(pDpyEvo, pDpyEvo->requestedColorBpcMax,
+                           &limitedDpyColor);
+
+        colorBpc = limitedDpyColor.bpc;
+        colorRange = limitedDpyColor.range;
+    }
+
