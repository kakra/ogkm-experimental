From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Englund <tomenglund26@gmail.com>
Date: Tue, 20 Oct 2026 11:13:51 +0200
Subject: [PATCH] nvidia-drm: allocate the atomic state with kvzalloc

struct nv_drm_atomic_state embeds NvKmsKapiRequestedModeSetConfig and is
~16.7 KB, so the kzalloc in nv_drm_atomic_state_alloc() is an order-3
page allocation on every atomic commit. Under memory fragmentation that
GFP_KERNEL request invokes the OOM killer from the compositor's commit
path while plenty of memory is still free (upstream issue 1254).

The state is only accessed by the CPU, so use kvzalloc()/kvfree(), which
tries the contiguous allocation without retrying hard and falls back to
vmalloc.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernel-open/nvidia-drm/nvidia-drm-modeset.c | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/kernel-open/nvidia-drm/nvidia-drm-modeset.c b/kernel-open/nvidia-drm/nvidia-drm-modeset.c
index 3dcd81b2..b359da4d 100644
--- a/kernel-open/nvidia-drm/nvidia-drm-modeset.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-modeset.c
@@ -48,6 +48,8 @@
 #endif
 
 #include <linux/dma-fence.h>
+#include <linux/mm.h>
+#include <linux/slab.h>
 
 struct nv_drm_atomic_state {
     struct NvKmsKapiRequestedModeSetConfig config;
@@ -63,12 +65,17 @@ static inline struct nv_drm_atomic_state *to_nv_atomic_state(
 nv_drm_atomic_state_base_t *
 nv_drm_atomic_state_alloc(struct drm_device *dev)
 {
+    /*
+     * The state is allocated on every atomic commit and is larger than a
+     * page (order-3 with kmalloc). It is CPU-only, so let kvzalloc fall back
+     * to vmalloc under fragmentation instead of invoking the OOM killer.
+     */
     struct nv_drm_atomic_state *nv_state =
-            nv_drm_calloc(1, sizeof(*nv_state));
+            kvzalloc(sizeof(*nv_state), GFP_KERNEL);
 
     if (nv_state == NULL ||
         nv_drm_atomic_state_base_init(dev, &nv_state->base) < 0) {
-        nv_drm_free(nv_state);
+        kvfree(nv_state);
         return NULL;
     }
 
@@ -85,7 +92,7 @@ void nv_drm_atomic_state_free(nv_drm_atomic_state_base_t *state)
     struct nv_drm_atomic_state *nv_state =
                     to_nv_atomic_state(state);
     nv_drm_atomic_state_base_default_release(state);
-    nv_drm_free(nv_state);
+    kvfree(nv_state);
 }
 
