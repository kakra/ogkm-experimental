From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Englund <tomenglund26@gmail.com>
Date: Sun, 1 Nov 2026 02:42:55 +0100
Subject: [PATCH] nvidia: don't report an ACPI _DDC without an EDID as success

When _DDC ran but didn't return a buffer, nv_acpi_ddc_method() returned NV_OK
with the size untouched, so callers got an all-zero EDID of the full size, and
that is what GSP received. It also stopped there, without trying the 128-byte
request after the 256-byte one.

Only accept a non-empty buffer. Otherwise try the smaller size, and fail if that
gives nothing either.

Builds against 7.3 and boots; the failure path hasn't been run.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernel-open/nvidia/nv-acpi.c | 37 ++++++++++++++++++------------------
 1 file changed, 18 insertions(+), 19 deletions(-)

diff --git a/kernel-open/nvidia/nv-acpi.c b/kernel-open/nvidia/nv-acpi.c
index b50f226e..83d61515 100644
--- a/kernel-open/nvidia/nv-acpi.c
+++ b/kernel-open/nvidia/nv-acpi.c
@@ -1101,37 +1101,36 @@ NV_STATUS NV_API_CALL nv_acpi_ddc_method(
 
         ddc_arg0.integer.value = i;
         status = acpi_evaluate_object(lcd_dev_handle, "_DDC", &input, &output);
-        if (ACPI_SUCCESS(status)) {
-            ddc = output.pointer;
+        if (ACPI_FAILURE(status))
+            continue;
+
+        ddc = output.pointer;
+        if (ddc && (ddc->type == ACPI_TYPE_BUFFER) && (ddc->buffer.length > 0))
             break;
-        }
+
+        // The method ran but gave no EDID of this size, try the smaller one
+        kfree(ddc);
+        ddc = NULL;
     }
 
-    if (ACPI_FAILURE(status))
+    if (ddc == NULL)
     {
         nv_printf(NV_DBG_INFO,
-                  "NVRM: %s: failed status: %08x \n",
+                  "NVRM: %s: no EDID, last status: %08x \n",
                   __FUNCTION__,
                   status);
         return NV_ERR_GENERIC;
     }
-    else
+
+    if (ddc->buffer.length > *pSize)
     {
-        if (ddc && (ddc->type == ACPI_TYPE_BUFFER) && (ddc->buffer.length > 0))
-        {
-            if (ddc->buffer.length <= *pSize)
-            {
-                *pSize = NV_MIN(*pSize, ddc->buffer.length);
-                memcpy(pEdidBuffer, ddc->buffer.pointer, *pSize);
-            }
-            else
-            {
-                kfree(ddc);
-                return NV_ERR_BUFFER_TOO_SMALL;
-            }
-        }
+        kfree(ddc);
+        return NV_ERR_BUFFER_TOO_SMALL;
     }
 
+    *pSize = ddc->buffer.length;
+    memcpy(pEdidBuffer, ddc->buffer.pointer, *pSize);
+
     kfree(ddc);
     return NV_OK;
 }
