 src/nvidia-modeset/src/nvkms-headsurface.c    | 31 +++++++++++++++++++
 src/nvidia-modeset/src/nvkms-surface.c        | 26 +++++++++++-----
 9 files changed, 91 insertions(+), 14 deletions(-)

diff --git a/kernel-open/nvidia-modeset/nvidia-modeset-linux.c b/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
index 3b66e975..0bf0ae73 100644
--- a/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
+++ b/kernel-open/nvidia-modeset/nvidia-modeset-linux.c
@@ -130,6 +130,12 @@ MODULE_PARM_DESC(lazy_ctxdma_bind,
 static bool lazy_ctxdma_bind = true;
 module_param_named(lazy_ctxdma_bind, lazy_ctxdma_bind, bool, 0644);
 
+MODULE_PARM_DESC(lazy_gpu_map,
+                 "Map registered surfaces into the NVKMS GPU address space (used by headSurface and DIFR) on first use "
+                 "instead of at registration. Affects surfaces registered after a change.");
+static bool lazy_gpu_map = true;
+module_param_named(lazy_gpu_map, lazy_gpu_map, bool, 0644);
+
 MODULE_PARM_DESC(enhanced_pcon_support,
                  "Enable enhanced display protocol converter features (e.g. VRR over active DP-HDMI converters)");
 static bool enhanced_pcon_support = false;
@@ -241,6 +247,11 @@ NvBool nvkms_lazy_ctxdma_bind(void)
     return READ_ONCE(lazy_ctxdma_bind);
 }
 
+NvBool nvkms_lazy_gpu_map(void)
+{
+    return READ_ONCE(lazy_gpu_map);
+}
+
 NvBool nvkms_output_rounding_fix(void)
 {
     return output_rounding_fix;
diff --git a/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h b/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
index 620f1aa4..4a20e4c2 100644
--- a/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
+++ b/kernel-open/nvidia-modeset/nvidia-modeset-os-interface.h
@@ -121,6 +121,7 @@ enum NvKmsFrlRateForce nvkms_force_frl_rate(void);
 NvBool nvkms_conceal_vrr_caps(void);
 NvBool nvkms_enhanced_pcon_support(void);
 NvBool nvkms_lazy_ctxdma_bind(void);
+NvBool nvkms_lazy_gpu_map(void);
 NvBool nvkms_output_rounding_fix(void);
 NvBool nvkms_disable_hdmi_frl(void);
 NvBool nvkms_disable_vrr_memclk_switch(void);
