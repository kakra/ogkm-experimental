diff --git a/kernel-open/nvidia/nv-procfs.c b/kernel-open/nvidia/nv-procfs.c
index c73180bd..1a5471ee 100644
--- a/kernel-open/nvidia/nv-procfs.c
+++ b/kernel-open/nvidia/nv-procfs.c
@@ -243,6 +243,48 @@ nv_procfs_read_version(
 
 NV_DEFINE_SINGLE_NVRM_PROCFS_FILE(version);
 
+/*
+ * Diagnostic: how often RM and nvidia-drm took paths that only run when
+ * video memory is short (nv-vram-pressure.h). One line per event: name,
+ * count, bytes, CLOCK_MONOTONIC time of the last event in ns (0: never).
+ * The counters only grow; sample and difference them.
+ */
+static const char * const nv_vram_pressure_names[NV_VRAM_PRESSURE_EVENT_COUNT] =
+{
+    [NV_VRAM_PRESSURE_VIDMEM_ALLOC_FAIL]   = "vidmem_alloc_fail",
+    [NV_VRAM_PRESSURE_SYSMEM_PAGE_RETRY]   = "sysmem_page_retry",
+    [NV_VRAM_PRESSURE_DMA_MAP_FAIL]        = "dma_map_fail",
+    [NV_VRAM_PRESSURE_DMA_UNMAP_FAIL]      = "dma_unmap_fail",
+    [NV_VRAM_PRESSURE_GEM_NO_COMPRESSION]  = "gem_no_compression",
+    [NV_VRAM_PRESSURE_GEM_SYSMEM_FALLBACK] = "gem_sysmem_fallback",
+    [NV_VRAM_PRESSURE_GEM_ALLOC_FAIL]      = "gem_alloc_fail",
+    [NV_VRAM_PRESSURE_GEM_BACKOFF]         = "gem_backoff",
+};
+
+static int
+nv_procfs_read_vram_pressure(
+    struct seq_file *s,
+    void *v
+)
+{
+    NvU32 i;
+
+    seq_printf(s, "# event count bytes last_ns now_ns=%llu\n", ktime_get_ns());
+
+    for (i = 0; i < NV_VRAM_PRESSURE_EVENT_COUNT; i++)
+    {
+        NvU64 count, bytes, last_ns;
+
+        os_vram_pressure_get(i, &count, &bytes, &last_ns);
+        seq_printf(s, "%s %llu %llu %llu\n", nv_vram_pressure_names[i],
+                   count, bytes, last_ns);
+    }
+
+    return 0;
+}
+
+NV_DEFINE_SINGLE_PROCFS_FILE_READ_ONLY_WITHOUT_LOCK(vram_pressure);
+
 static void
 nv_procfs_close_file(
     nv_procfs_private_t *nvpp
@@ -1423,6 +1465,10 @@ int nv_procfs_init(void)
     if (!entry)
         goto failed;
 
+    entry = NV_CREATE_PROC_FILE("vram_pressure", proc_nvidia, vram_pressure, NULL);
+    if (!entry)
+        goto failed;
+
     proc_nvidia_gpus = NV_CREATE_PROC_DIR("gpus", proc_nvidia);
     if (!proc_nvidia_gpus)
         goto failed;
diff --git a/kernel-open/nvidia/os-interface.c b/kernel-open/nvidia/os-interface.c
index 8f9a0ee0..ac669034 100644
--- a/kernel-open/nvidia/os-interface.c
+++ b/kernel-open/nvidia/os-interface.c
@@ -1480,6 +1480,41 @@ void NV_API_CALL os_dump_stack(void)
     dump_stack();
 }
 
+/*
+ * Video memory pressure counters (nv-vram-pressure.h), read by
+ * /proc/driver/nvidia/vram_pressure. Updated without locks from RM and
+ * nvidia-drm error paths; a reader may see a count without its bytes for a
+ * moment, which a sampler can live with.
+ */
+static atomic64_t nv_vram_pressure_count[NV_VRAM_PRESSURE_EVENT_COUNT];
+static atomic64_t nv_vram_pressure_bytes[NV_VRAM_PRESSURE_EVENT_COUNT];
+static atomic64_t nv_vram_pressure_last_ns[NV_VRAM_PRESSURE_EVENT_COUNT];
+
+void NV_API_CALL os_vram_pressure_event(NvU32 event, NvU64 bytes)
+{
+    if (event >= NV_VRAM_PRESSURE_EVENT_COUNT)
+        return;
+
+    atomic64_inc(&nv_vram_pressure_count[event]);
+    atomic64_add(bytes, &nv_vram_pressure_bytes[event]);
+    atomic64_set(&nv_vram_pressure_last_ns[event], ktime_get_ns());
+}
+EXPORT_SYMBOL(os_vram_pressure_event);
+
+void NV_API_CALL os_vram_pressure_get(NvU32 event, NvU64 *count, NvU64 *bytes,
+                                      NvU64 *last_ns)
+{
+    if (event >= NV_VRAM_PRESSURE_EVENT_COUNT)
+    {
+        *count = *bytes = *last_ns = 0;
+        return;
+    }
+
+    *count   = atomic64_read(&nv_vram_pressure_count[event]);
+    *bytes   = atomic64_read(&nv_vram_pressure_bytes[event]);
+    *last_ns = atomic64_read(&nv_vram_pressure_last_ns[event]);
+}
+
 typedef struct os_spinlock_s
 {
     nv_spinlock_t      lock;
