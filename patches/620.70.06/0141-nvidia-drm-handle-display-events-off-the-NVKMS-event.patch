-    mutex_unlock(&dev->mode_config.mutex);
-    queue_delayed_work(nv_drm_percpu_wq, &nv_dev->content_protection_event_work, 0);
+    nv_drm_connector_update_content_protection(nv_encoder->nv_connector);
