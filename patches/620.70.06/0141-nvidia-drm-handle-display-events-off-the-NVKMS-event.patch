     atomic_set(&nv_dev->enable_event_handling, false);
-    cancel_delayed_work_sync(&nv_dev->hotplug_event_work);
     cancel_delayed_work_sync(&nv_dev->content_protection_event_work);
+    cancel_delayed_work_sync(&nv_dev->hotplug_event_work);
