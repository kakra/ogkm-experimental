+static NvBool MstI2cTransfer(struct NvKmsPerOpen *pOpen, void *pParamsVoid)
+{
+    struct NvKmsMstI2cTransferParams *pParams = pParamsVoid;
+    struct NvKmsMstI2cTransfer *transfer = &pParams->request.transfer;
+    NVDpyEvoRec *pDpyEvo;
