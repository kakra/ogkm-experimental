+        transfer->writeSize > NVKMS_MST_I2C_MAX_DATA ||
+        transfer->readSize > NVKMS_MST_I2C_MAX_DATA ||
+        (transfer->writeSize == 0 && transfer->readSize == 0)) {
+        return FALSE;
+    }
+    return nvDPMstI2cTransfer(pDpyEvo, pParams);
+}
