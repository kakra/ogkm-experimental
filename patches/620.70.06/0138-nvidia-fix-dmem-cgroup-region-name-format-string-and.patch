 void osCgroupUnregisterRegion(void *region, void *prechargePool, NvU64 precharge);
 NV_STATUS osMemacctTryCharge(void *pRegion, NvLength size, void **ppPool, void **limitPool);
-void osMemacctReleaseCharge(void *pool, NvLength size);
+NvBool osMemacctReleaseCharge(void *pool, NvLength size);
 void osMemacctPoolStatePut(void *pool);
 void *osCgroupGetFromFd(NvS32 fd);
 void osCgroupPut(void *cgroup);
diff --git a/src/nvidia/src/kernel/mem_mgr/memacct.c b/src/nvidia/src/kernel/mem_mgr/memacct.c
index e607bb8c..2da5a9e7 100644
--- a/src/nvidia/src/kernel/mem_mgr/memacct.c
+++ b/src/nvidia/src/kernel/mem_mgr/memacct.c
@@ -294,18 +294,11 @@ void memacctReleaseCharge(MemoryCharge *pCharge)
     notify = NV_FALSE;
     if (g_memacct.impl == CGROUP_IMPL_OS)
     {
-        NvBool overSoftLimitBefore;
-        NvBool overSoftLimitAfter;
-
         NV_PRINTF(LEVEL_INFO, "release %llu for pool 0x%016llx\n", pCharge->size,
             (NvU64)pCharge->osPool);
 
-        overSoftLimitBefore = osCgroupCanEvict(NULL, pCharge->osPool);
-        osMemacctReleaseCharge(pCharge->osPool, pCharge->size);
-        overSoftLimitAfter = osCgroupCanEvict(NULL, pCharge->osPool);
-
-        if (overSoftLimitBefore && !overSoftLimitAfter)
-            notify = NV_TRUE;
+        // osPool may be freed once released; the OS layer does both soft limit checks
+        notify = osMemacctReleaseCharge(pCharge->osPool, pCharge->size);
     }
     else
     {
