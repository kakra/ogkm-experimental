+++ b/src/nvidia/arch/nvalloc/unix/include/os-interface.h
@@ -311,7 +311,7 @@ NvU32 NV_API_CALL os_cgroup_implementation(void);
 void* NV_API_CALL os_dmem_cgroup_register_region(const char *name, NvU64 size, NvU64 precharge, void **prechargePool);
 void NV_API_CALL os_dmem_cgroup_unregister_region(void *region, void *prechargePool, NvU64 precharge);
 NV_STATUS NV_API_CALL os_dmem_cgroup_try_charge(void *region, NvU64 size, void **ret_pool, void **ret_limit_pool);
-void NV_API_CALL os_dmem_cgroup_uncharge(void *pool, NvU64 size);
+NvBool NV_API_CALL os_dmem_cgroup_uncharge(void *pool, NvU64 size);
 void NV_API_CALL os_dmem_cgroup_pool_state_put(void *pool);
 NvBool NV_API_CALL os_dmem_cgroup_state_evict_valuable(void *limit_pool, void *test_pool, NvBool ignore_low, NvBool *ret_hit_low);
 void* NV_API_CALL os_cgroup_get_from_fd(NvU32 fd);
@@ -323,7 +323,7 @@ void* NV_API_CALL os_cgroup_parent(void *cgroup);
 #define os_dmem_cgroup_register_region(...)      NULL
 #define os_dmem_cgroup_unregister_region(...)
 #define os_dmem_cgroup_try_charge(...)           NV_OK
-#define os_dmem_cgroup_uncharge(...)
+#define os_dmem_cgroup_uncharge(...)            NV_FALSE
 #define os_dmem_cgroup_pool_state_put(...)
 #define os_dmem_cgroup_state_evict_valuable(...) NV_FALSE
 #define os_cgroup_get_from_fd(...)               NULL
diff --git a/src/nvidia/arch/nvalloc/unix/src/os.c b/src/nvidia/arch/nvalloc/unix/src/os.c
index c079c4f8..fdc39510 100644
--- a/src/nvidia/arch/nvalloc/unix/src/os.c
+++ b/src/nvidia/arch/nvalloc/unix/src/os.c
@@ -2304,9 +2304,9 @@ NV_STATUS osMemacctTryCharge(void *pRegion, NvLength size, void **ppPool, void *
     return os_dmem_cgroup_try_charge(pRegion, size, ppPool, limitPool);
 }
 
-void osMemacctReleaseCharge(void *pool, NvLength size)
+NvBool osMemacctReleaseCharge(void *pool, NvLength size)
 {
-    os_dmem_cgroup_uncharge(pool, size);
+    return os_dmem_cgroup_uncharge(pool, size);
 }
 
 void osMemacctPoolStatePut(void *pool)
diff --git a/src/nvidia/generated/g_os_nvoc.h b/src/nvidia/generated/g_os_nvoc.h
index ae43552f..75e7a346 100644
--- a/src/nvidia/generated/g_os_nvoc.h
+++ b/src/nvidia/generated/g_os_nvoc.h
@@ -347,7 +347,7 @@ ClientGroupID osClientGroupID(NvU64 process, void *pidInfo); // from osGetCurren
