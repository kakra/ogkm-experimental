From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tom Englund <tomenglund26@gmail.com>
Date: Sat, 7 Nov 2026 09:17:37 +0100
Subject: [PATCH] nvkms: check the EDID VRR maximum and HDMI 2.1 VRRmin/VRRmax
 validity

VRR was enabled on any mode at or above 110% of the EDID minimum; the
maximum was never looked at. A mode above the sink's VRR range (an HDMI
2.1 sink with VRRmax below the mode's refresh rate, or a DP mode above
the range limits) got VRR anyway. Like amdgpu, only use VRR on
Adaptive-Sync displays when the rounded refresh rate is within the
EDID maximum: DisplayID/EDID range limits on DP, HF-VSDB VRRmax on HDMI
(0 = up to the mode's own refresh rate). G-SYNC displays are unchanged.

HDMI 2.1 also limits VRRmin to 1-48 Hz and VRRmax to 0 or >= 100 Hz;
an HF-VSDB outside that is invalid, so don't report HDMI VRR then.

HDMI vrr.type was never cleared on an EDID change, so a new sink
without VRR kept the previous sink's caps; reset it for non-DP
connectors before re-reading the caps.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/modeset/timing/nvt_util.c | 93 ++++++++++++++++++++++++++++
 src/common/modeset/timing/nvtiming.h |  2 +
 src/nvidia-modeset/src/nvkms-dpy.c   |  9 +++
 src/nvidia-modeset/src/nvkms-hdmi.c  | 11 +++-
 src/nvidia-modeset/src/nvkms-vrr.c   | 44 +++++++++++++
 5 files changed, 158 insertions(+), 1 deletion(-)

diff --git a/src/common/modeset/timing/nvt_util.c b/src/common/modeset/timing/nvt_util.c
index 25fa2b24..ea15bb3a 100644
--- a/src/common/modeset/timing/nvt_util.c
+++ b/src/common/modeset/timing/nvt_util.c
@@ -573,4 +573,97 @@ NvU32 NvTiming_GetVrrFmin(
     return fmin;
 }
 
+//
+// Highest refresh rate the sink supports VRR at, from the same EDID/DisplayID
+// sources NvTiming_GetVrrFmin() uses for the minimum. 0 means no limit beyond
+// the mode's own refresh rate.
+//
+CODE_SEGMENT(PAGE_DD_CODE)
+NvU32 NvTiming_GetVrrFmax(
+    const NVT_EDID_INFO *pEdidInfo,
+    const NVT_DISPLAYID_2_0_INFO *pDisplayIdInfo,
+    NvU32 nominalRefreshRateHz,
+    NVT_PROTOCOL sinkProtocol)
+{
+    NvU32 fmax = 0;
+    NvU32 i;
+
+    // DP Adaptive Sync
+    if (sinkProtocol == NVT_PROTOCOL_DP)
+    {
+        if (pEdidInfo)
+        {
+            // G-SYNC modules manage their own range.
+            if (pEdidInfo->nvdaVsdbInfo.valid)
+            {
+                return 0;
+            }
+
+            if (pEdidInfo->ext_displayid.version)
+            {
+                fmax = pEdidInfo->ext_displayid.range_limits[0].vfreq_max;
+            }
+
+            if (pEdidInfo->ext_displayid20.version && pEdidInfo->ext_displayid20.range_limits.seamless_dynamic_video_timing_change)
+            {
+                fmax = pEdidInfo->ext_displayid20.range_limits.vfreq_max;
+            }
+
+            // DisplayID 2.0 extension: the Adaptive Sync descriptor for this refresh rate
+            if (pEdidInfo->ext_displayid20.version && pEdidInfo->ext_displayid20.total_adaptive_sync_descriptor != 0)
+            {
+                for (i = 0; i < pEdidInfo->ext_displayid20.total_adaptive_sync_descriptor; i++)
+                {
+                    if ((pEdidInfo->ext_displayid20.adaptive_sync_descriptor[i].max_rr == nominalRefreshRateHz) ||
+                        (nominalRefreshRateHz == 0))
+                    {
+                        fmax = pEdidInfo->ext_displayid20.adaptive_sync_descriptor[i].max_rr;
+                        break;
+                    }
+                }
+            }
+
+            if (!fmax)
+            {
+                for (i = 0; i < NVT_EDID_MAX_LONG_DISPLAY_DESCRIPTOR; i++)
+                {
+                    if (pEdidInfo->ldd[i].tag == NVT_EDID_DISPLAY_DESCRIPTOR_DRL)
+                    {
+                        fmax = pEdidInfo->ldd[i].u.range_limit.max_v_rate;
+                    }
+                }
+            }
+        }
+
+        // Native Display ID 2.0
+        if (pDisplayIdInfo)
+        {
+            for (i = 0; i < pDisplayIdInfo->total_adaptive_sync_descriptor; i++)
+            {
+                if ((pDisplayIdInfo->adaptive_sync_descriptor[i].max_rr == nominalRefreshRateHz) ||
+                    (nominalRefreshRateHz == 0))
+                {
+                    fmax = pDisplayIdInfo->adaptive_sync_descriptor[i].max_rr;
+                    break;
+                }
+            }
+            if (!fmax)
+            {
+                fmax = pDisplayIdInfo->range_limits.vfreq_max;
+            }
+        }
+    }
+
+    // HDMI 2.1 VRR: VRRmax 0 means up to the mode's Base Refresh Rate.
+    else if (sinkProtocol == NVT_PROTOCOL_HDMI)
+    {
+        if (pEdidInfo)
+        {
+            fmax = pEdidInfo->hdmiForumInfo.vrr_max;
+        }
+    }
+
+    return fmax;
+}
+
 POP_SEGMENTS
diff --git a/src/common/modeset/timing/nvtiming.h b/src/common/modeset/timing/nvtiming.h
index b06dfc9d..bfb59222 100644
--- a/src/common/modeset/timing/nvtiming.h
+++ b/src/common/modeset/timing/nvtiming.h
@@ -5846,6 +5846,8 @@ NvU16 NvTiming_MaxFrameWidth(NvU16 HVisible, NvU16 rep);
 
 NvU32 NvTiming_GetVrrFmin(const NVT_EDID_INFO *pEdidInfo, const NVT_DISPLAYID_2_0_INFO *pDisplayIdInfo,
                           NvU32 nominalRefreshRateHz, NVT_PROTOCOL sinkProtocol);
+NvU32 NvTiming_GetVrrFmax(const NVT_EDID_INFO *pEdidInfo, const NVT_DISPLAYID_2_0_INFO *pDisplayIdInfo,
+                          NvU32 nominalRefreshRateHz, NVT_PROTOCOL sinkProtocol);
 
 // Establish timing enumeration
 NVT_STATUS NvTiming_EnumEST(NvU32 index, NVT_TIMING *pT);
diff --git a/src/nvidia-modeset/src/nvkms-dpy.c b/src/nvidia-modeset/src/nvkms-dpy.c
index 704c4438..5134ddf5 100644
--- a/src/nvidia-modeset/src/nvkms-dpy.c
+++ b/src/nvidia-modeset/src/nvkms-dpy.c
@@ -476,6 +476,15 @@ static void ApplyNewEdid(
     /* Write information about the parsed EDID to the infoString. */
     LogEdid(pDpyEvo, pInfoString);
 
+    /*
+     * HDMI VRR caps come only from the EDID (nvDpyUpdateHdmiVRRCaps), which
+     * never clears them; reset here so a new EDID without valid VRR caps
+     * doesn't keep the previous sink's.  DP sets vrr.type in EnableVRR().
+     */
+    if (!nvConnectorUsesDPLib(pDpyEvo->pConnectorEvo)) {
+        pDpyEvo->vrr.type = NVKMS_DPY_VRR_TYPE_NONE;
+    }
+
     if (pDpyEvo->parsedEdid.valid) {
         /*
          * check 3D Vision capability
diff --git a/src/nvidia-modeset/src/nvkms-hdmi.c b/src/nvidia-modeset/src/nvkms-hdmi.c
index 49ee81d1..9d1dc83f 100644
--- a/src/nvidia-modeset/src/nvkms-hdmi.c
+++ b/src/nvidia-modeset/src/nvkms-hdmi.c
@@ -1635,10 +1635,19 @@ void nvDpyUpdateHdmiVRRCaps(NVDpyEvoPtr pDpyEvo)
                                        !nvkms_conceal_vrr_caps();
 
     const NvU32 edidVrrMin = pParsedEdid->info.hdmiForumInfo.vrr_min;
+    const NvU32 edidVrrMax = pParsedEdid->info.hdmiForumInfo.vrr_max;
+
+    /*
+     * HDMI 2.1: VRRmin is 1-48 Hz, VRRmax is 0 (up to the Base Refresh Rate)
+     * or >= 100 Hz.  Anything else is an invalid HF-VSDB; don't use VRR.
+     */
+    const NvBool edidVrrValid =
+        (edidVrrMin >= 1) && (edidVrrMin <= 48) &&
+        ((edidVrrMax == 0) || (edidVrrMax >= 100));
 
     nvAssert(pParsedEdid->valid);
 
-    if (dispSupportsVrr && (edidVrrMin > 0)) {
+    if (dispSupportsVrr && edidVrrValid) {
         if (nvDpyIsAdaptiveSyncDefaultlisted(pDpyEvo)) {
             pDpyEvo->vrr.type =
                 NVKMS_DPY_VRR_TYPE_ADAPTIVE_SYNC_DEFAULTLISTED;
diff --git a/src/nvidia-modeset/src/nvkms-vrr.c b/src/nvidia-modeset/src/nvkms-vrr.c
index 744f4cd9..02260eb5 100644
--- a/src/nvidia-modeset/src/nvkms-vrr.c
+++ b/src/nvidia-modeset/src/nvkms-vrr.c
@@ -266,6 +266,35 @@ static NvBool GetEdidMinRefreshRate(
     return TRUE;
 }
 
+/*
+ * Highest refresh rate the EDID allows VRR at for an Adaptive-Sync display:
+ * the DP range limits, or the HDMI 2.1 HF-VSDB VRRmax.  0 means no limit.
+ */
+static NvU32 GetEdidMaxRefreshRate(
+    const NVDpyEvoRec *pDpyEvo,
+    const NVHwModeTimingsEvo *pTimings)
+{
+    const NVParsedEdidEvoRec *pParsedEdid = &pDpyEvo->parsedEdid;
+    NVT_PROTOCOL sinkProtocol;
+
+    if (!pParsedEdid->valid) {
+        return 0;
+    }
+
+    if (nvDpyUsesDPLib(pDpyEvo)) {
+        sinkProtocol = NVT_PROTOCOL_DP;
+    } else if (nvDpyIsHdmiEvo(pDpyEvo)) {
+        sinkProtocol = NVT_PROTOCOL_HDMI;
+    } else {
+        return 0;
+    }
+
+    return NvTiming_GetVrrFmax(&pParsedEdid->info,
+                               NULL,
+                               nvGetRefreshRatex10K(pTimings) / 10000,
+                               sinkProtocol);
+}
+
 /*! Adjust mode timings as necessary for VRR. */
 void nvAdjustHwModeTimingsForVrrEvo(const NVDpyEvoRec *pDpyEvo,
                                     const enum NvKmsRequestedVrrType vrrType,
@@ -312,6 +341,21 @@ void nvAdjustHwModeTimingsForVrrEvo(const NVDpyEvoRec *pDpyEvo,
         return;
     }
 
+    /*
+     * Disallow VRR on Adaptive-Sync displays if the refresh rate is above the
+     * EDID's VRR maximum (DP range limits, HDMI 2.1 VRRmax).  Round like
+     * drm_mode_vrefresh(), so a 240.002 Hz mode passes a 240 Hz limit.
+     */
+    if ((pDpyEvo->vrr.type == NVKMS_DPY_VRR_TYPE_ADAPTIVE_SYNC_DEFAULTLISTED) ||
+        (pDpyEvo->vrr.type == NVKMS_DPY_VRR_TYPE_ADAPTIVE_SYNC_NON_DEFAULTLISTED)) {
+        const NvU32 maxRefreshRate = GetEdidMaxRefreshRate(pDpyEvo, pTimings);
+
+        if ((maxRefreshRate != 0) &&
+            (((nvGetRefreshRatex10K(pTimings) + 5000) / 10000) > maxRefreshRate)) {
+            return;
+        }
+    }
+
     /*
      * On G-SYNC panels, the back porch extension is used to indicate to
      * the monitor that VRR is enabled.  It is not necessary on
