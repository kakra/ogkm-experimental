 extern NvU32 NVreg_EnableSystemMemoryPools;
 
+/*
+ * Uncached and write-combined allocations change the page attributes of the
+ * kernel mapping on alloc and free, a TLB shootdown on every CPU each time.
+ * Keep their pages in separate pools that leave them uncached, so reuse
+ * skips both changes.
+ */
+#if defined(NV_SET_PAGES_ARRAY_UC_PRESENT) && !defined(NV_SET_MEMORY_ARRAY_UC_PRESENT)
+#define NV_UNCACHED_POOL_SUPPORTED 1
+#else
+#define NV_UNCACHED_POOL_SUPPORTED 0
+#endif
+
+static unsigned int uncached_pool_max_mb = 256;
+module_param(uncached_pool_max_mb, uint, 0644);
+MODULE_PARM_DESC(uncached_pool_max_mb,
+                 "MiB of uncached and write-combined system memory kept uncached "
+                 "for reuse after free (0 disables).");
+
+static atomic_long_t nv_uncached_pool_pages = ATOMIC_LONG_INIT(0);
