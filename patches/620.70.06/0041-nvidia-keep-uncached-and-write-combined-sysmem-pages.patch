 }
 
+// Clear through a write-combined mapping, the kernel mapping is uncached
 static void
-nv_mem_pool_clear_page(unsigned long virt_addr, unsigned int order)
+nv_mem_pool_clear_uncached_page(unsigned long virt_addr, unsigned int order)
 {
     unsigned int os_pages_in_page = 1 << order;
+    struct page *page = virt_to_page((void *)virt_addr);
+    struct page *single_page;
+    struct page **pages = &single_page;
+    void *ptr = NULL;
     unsigned int i;
 
+    if (os_pages_in_page > 1)
+        pages = kmalloc_array(os_pages_in_page, sizeof(*pages), NV_GFP_KERNEL);
+
+    if (pages != NULL)
+    {
+        for (i = 0; i < os_pages_in_page; i++)
+            pages[i] = page + i;
+
+        ptr = vmap(pages, os_pages_in_page, VM_MAP, pgprot_writecombine(PAGE_KERNEL));
+    }
+
+    if (ptr != NULL)
+    {
+        memset(ptr, 0, PAGE_SIZE << order);
+        wmb();
+        vunmap(ptr);
+    }
+    else
+    {
+        memset((void *)virt_addr, 0, PAGE_SIZE << order);
+    }
+
+    if (pages != &single_page)
+        kfree(pages);
+}
+
+static void
+nv_mem_pool_clear_page(nv_page_pool_t *mem_pool, unsigned long virt_addr)
+{
+    unsigned int os_pages_in_page = 1 << mem_pool->order;
+    unsigned int i;
+
+    if (mem_pool->uncached)
+    {
+        nv_mem_pool_clear_uncached_page(virt_addr, mem_pool->order);
+        return;
+    }
+
     for (i = 0; i < os_pages_in_page; i++)
     {
         clear_page((void *)(virt_addr + i * PAGE_SIZE));
     }
 }
 
+// Fill pages first_page .. first_page + max_num_pages - 1 of at
