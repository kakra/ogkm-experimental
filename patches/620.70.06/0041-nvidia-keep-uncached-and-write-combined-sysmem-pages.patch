+// Pages from an uncached pool must be write-back again before they're freed
 static void
-nv_mem_pool_free_page_list
+nv_mem_pool_set_list_wb
 (
-    struct list_head *free_list,
+    struct list_head *list,
     unsigned int order
 )
 {
+#if NV_UNCACHED_POOL_SUPPORTED
+    struct page *pages[32];
+    nv_page_pool_entry_t *pool_entry;
+    unsigned int num_pages = 0;
+    unsigned int i;
+
+    list_for_each_entry(pool_entry, list, list_node)
+    {
+        struct page *page = virt_to_page((void *)pool_entry->virt_addr);
+
+        for (i = 0; i < (1U << order); i++)
+        {
+            pages[num_pages++] = page + i;
+            if (num_pages == ARRAY_SIZE(pages))
+            {
+                set_pages_array_wb(pages, num_pages);
+                num_pages = 0;
+            }
+        }
+    }
+
+    if (num_pages != 0)
+        set_pages_array_wb(pages, num_pages);
+#endif
+}
+
+static void
+nv_mem_pool_free_page_list
+(
+    nv_page_pool_t *mem_pool,
+    struct list_head *free_list
+)
+{
+    if (mem_pool->uncached)
+        nv_mem_pool_set_list_wb(free_list, mem_pool->order);
+
     while (!list_empty(free_list))
     {
         nv_page_pool_entry_t *pool_entry = NV_MEM_POOL_LIST_HEAD(free_list);
         list_del(&pool_entry->list_node);
-        NV_FREE_PAGES(pool_entry->virt_addr, order)
+        NV_FREE_PAGES(pool_entry->virt_addr, mem_pool->order)
         NV_KFREE(pool_entry, sizeof(*pool_entry));
     }
 }
