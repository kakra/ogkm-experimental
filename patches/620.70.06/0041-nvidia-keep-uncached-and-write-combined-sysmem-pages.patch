 }
@@ -863,6 +987,106 @@ static nv_page_pool_t *nv_mem_pool_get(int node_id, unsigned int order)
     return sysmem_page_pools[node_id][order];
 }
 
+static nv_page_pool_t *nv_mem_pool_get_uncached(int node_id, unsigned int order)
+{
+    if (node_id >= ARRAY_SIZE(uncached_page_pools))
+        return NULL;
+
+    if (order >= ARRAY_SIZE(uncached_page_pools[node_id]))
+        return NULL;
+
+    return uncached_page_pools[node_id][order];
+}
+
+/*
+ * Whether at may take pages from and give pages to an uncached pool. Every
+ * OS page of every allocated page must be uncached, so no partial last page.
+ */
+static NvBool nv_uncached_pool_usable(nv_alloc_t *at)
+{
+    unsigned int os_pages_in_page = 1 << at->order;
+
+    return NV_UNCACHED_POOL_SUPPORTED &&
+           READ_ONCE(uncached_pool_max_mb) != 0 &&
+           at->cache_type != NV_MEMORY_CACHED &&
+           !at->flags.unencrypted &&
+           !at->flags.aliased &&
+           !at->flags.coherent &&
+           (at->flags.contig ? (at->num_pages == 1) :
+                               ((at->num_pages & (os_pages_in_page - 1)) == 0)) &&
+           num_online_nodes() <= 1;
+}
+
+// Add the still uncached pages of at to an uncached pool, all or none
+static NV_STATUS
+nv_mem_pool_free_uncached_pages
+(
+    nv_page_pool_t *mem_pool,
+    nv_alloc_t *at
+)
+{
+    unsigned int os_pages_in_page = 1 << at->order;
+    unsigned int num_pages = at->num_pages / os_pages_in_page;
+    unsigned long max_os_pages = (unsigned long)READ_ONCE(uncached_pool_max_mb) << (20 - PAGE_SHIFT);
+    nv_page_pool_entry_t *pool_entry, *next;
+    struct list_head freed_pages;
+    NvBool queue_worker;
+    unsigned int i;
+    NV_STATUS status;
+
+    if (!NV_MAY_SLEEP() ||
+        atomic_long_read(&nv_uncached_pool_pages) + at->num_pages > max_os_pages)
+    {
+        return NV_ERR_NO_MEMORY;
+    }
+
+    INIT_LIST_HEAD(&freed_pages);
+
+    for (i = 0; i < num_pages; i++)
+    {
+        nvidia_pte_t *page_ptr = &at->page_table[i * os_pages_in_page];
+
+        if (page_ptr->virt_addr == 0 ||
+            page_to_nid(NV_GET_PAGE_STRUCT(page_ptr->phys_addr)) != mem_pool->node_id)
+        {
+            goto failed;
+        }
+
+        NV_KZALLOC(pool_entry, sizeof(*pool_entry));
+        if (pool_entry == NULL)
+            goto failed;
+
+        pool_entry->virt_addr = page_ptr->virt_addr;
+        list_add_tail(&pool_entry->list_node, &freed_pages);
+    }
+
+    status = os_acquire_mutex(mem_pool->lock);
+    WARN_ON(status != NV_OK);
+    // Worker is already queued if list is not empty
+    queue_worker = list_empty(&mem_pool->dirty_list);
+    list_splice_tail_init(&freed_pages, &mem_pool->dirty_list);
+    mem_pool->pages_owned += num_pages;
+    os_release_mutex(mem_pool->lock);
+
+    nv_mem_pool_mod_misc_reclaimable(mem_pool, (long)num_pages);
+
+    if (queue_worker)
+    {
+        nv_mem_pool_queue_worker(mem_pool);
+    }
+
+    return NV_OK;
+
+failed:
+    list_for_each_entry_safe(pool_entry, next, &freed_pages, list_node)
+    {
+        list_del(&pool_entry->list_node);
+        NV_KFREE(pool_entry, sizeof(*pool_entry));
+    }
+
+    return NV_ERR_NO_MEMORY;
+}
