#!/usr/bin/env bpftrace
/*
 * NVIDIA RM object/GPU-VA lifecycle tracer (original; written from the
 * 615.78.08 headers nv_escape.h, nv-ioctl-numbers.h, nv-ioctl.h, nvos.h).
 *
 * Records, per thread, the raw parameter block of each RM escape that can
 * create, map, unmap, duplicate or free an object, read twice: at syscall
 * entry (what the kernel is about to copy in) and at syscall exit (what it
 * copied out). Entry/exit differences in IN fields show a concurrent writer.
 * Decoding and the VA model live in nv_va_analyze.py, not here.
 *
 * Escapes (nv_escape.h): 0x27 RM_ALLOC_MEMORY (NVOS02 [+fd]), 0x29 RM_FREE
 * (NVOS00), 0x2B RM_ALLOC (NVOS21 or NVOS64, by size), 0x34 RM_DUP_OBJECT
 * (NVOS55), 0x57 RM_MAP_MEMORY_DMA (NVOS46), 0x58 RM_UNMAP_MEMORY_DMA
 * (NVOS47). NV_ESC_IOCTL_XFER_CMD (200+11) carries {cmd,size,ptr}.
 *
 * Usage: sudo bpftrace nv-va-trace.bt > trace.log   (Ctrl-C to stop)
 * Read-only: no writes to user memory, no signals, no overrides.
 */
config = { max_strlen = 128 }

tracepoint:syscalls:sys_enter_openat
{
  $path = str(args.filename);
  if (strncmp($path, "/dev/nvidia", 11) == 0) { @open_path[tid] = $path; }
}

tracepoint:syscalls:sys_exit_openat
/ @open_path[tid] != "" /
{
  $path = @open_path[tid];
  if (args.ret >= 0) {
    @nvfd[pid, args.ret] = 1;
    printf("O %llu %d %d fd=%d path=%s comm=%s\n", nsecs, pid, tid, args.ret, $path, comm);
  }
  delete(@open_path[tid]);
}

tracepoint:syscalls:sys_enter_close
/ @nvfd[pid, args.fd] /
{
  printf("C %llu %d %d fd=%d comm=%s\n", nsecs, pid, tid, args.fd, comm);
  delete(@nvfd[pid, args.fd]);
}

tracepoint:syscalls:sys_enter_ioctl
/ ((args.cmd >> 8) & 0xff) == 0x46 /
{
  $nr = args.cmd & 0xff;
  $size = (args.cmd >> 16) & 0x3fff;
  $ptr = (uint64)args.arg;
  $xfer = 0;
  if ($nr == 211) {
    $nr = *(uint32 *)uptr(args.arg);
    $size = *(uint32 *)uptr(args.arg + 4);
    $ptr = *(uint64 *)uptr(args.arg + 8);
    $xfer = 1;
  }
  if ($nr == 0x27 || $nr == 0x29 || $nr == 0x2b || $nr == 0x34 || $nr == 0x57 || $nr == 0x58) {
    @nvpid[pid] = 1;
    @t_nr[tid] = $nr; @t_size[tid] = $size; @t_ptr[tid] = $ptr; @t_fd[tid] = args.fd;
    printf("E %llu %d %d fd=%d nr=0x%x size=%d xfer=%d blk=", nsecs, pid, tid, args.fd, $nr, $size, $xfer);
    if ($size == 16) { printf("%rx", buf(uptr($ptr), 16)); }
    else if ($size == 28) { printf("%rx", buf(uptr($ptr), 28)); }
    else if ($size == 32) { printf("%rx", buf(uptr($ptr), 32)); }
    else if ($size == 48) { printf("%rx", buf(uptr($ptr), 48)); }
    else if ($size == 56) { printf("%rx", buf(uptr($ptr), 56)); }
    else if ($size == 64) { printf("%rx", buf(uptr($ptr), 64)); }
    else { printf("UNSUPPORTED_SIZE"); }
    printf(" comm=%s\n", comm);
  }
}

tracepoint:syscalls:sys_exit_ioctl
/ @t_size[tid] /
{
  $nr = @t_nr[tid]; $size = @t_size[tid]; $ptr = @t_ptr[tid];
  printf("X %llu %d %d fd=%d nr=0x%x size=%d ret=%d blk=", nsecs, pid, tid, @t_fd[tid], $nr, $size, args.ret);
  if ($size == 16) { printf("%rx", buf(uptr($ptr), 16)); }
  else if ($size == 28) { printf("%rx", buf(uptr($ptr), 28)); }
  else if ($size == 32) { printf("%rx", buf(uptr($ptr), 32)); }
  else if ($size == 48) { printf("%rx", buf(uptr($ptr), 48)); }
  else if ($size == 56) { printf("%rx", buf(uptr($ptr), 56)); }
  else if ($size == 64) { printf("%rx", buf(uptr($ptr), 64)); }
  else { printf("UNSUPPORTED_SIZE"); }
  printf(" comm=%s\n", comm);
  /* User stack only for a failed map/unmap: status @56 (NVOS46), @40 (NVOS47). */
  $status = (uint32)0;
  if ($nr == 0x57 && $size == 64) { $status = *(uint32 *)uptr($ptr + 56); }
  if ($nr == 0x58 && $size == 48) { $status = *(uint32 *)uptr($ptr + 40); }
  if ($status != 0) {
    printf("S %llu %d %d status=0x%x%s\nS-END\n", nsecs, pid, tid, $status, ustack(perf, 16));
  }
  delete(@t_nr[tid]); delete(@t_size[tid]); delete(@t_ptr[tid]); delete(@t_fd[tid]);
}

tracepoint:sched:sched_process_exit
/ @nvpid[pid] && pid == tid /
{
  printf("P %llu %d %d exit comm=%s\n", nsecs, pid, tid, comm);
  delete(@nvpid[pid]);
}

END
{
  clear(@open_path); clear(@nvfd); clear(@nvpid);
  clear(@t_nr); clear(@t_size); clear(@t_ptr); clear(@t_fd);
}
